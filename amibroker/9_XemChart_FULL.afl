// ============================================================================
// DAO GAM SYSTEM v12 FULL - XEM TAT CA MA
// (SL=6, Bo qua ADX khi diem>=2.0, Ban can 3 phien xac nhan)
// ============================================================================
_SECTION_BEGIN("Dao Gam System v14 FULL");

TenkanLen   = Param("Tenkan", 9, 2, 50, 1);
KijunLen    = Param("Kijun", 17, 2, 100, 1);
SenkouBLen  = Param("Senkou B", 33, 2, 150, 1);
Shift       = Param("Dich chuyen may", 26, 1, 60, 1);
CB1Len      = Param("Duong can bang dai han 1", 65, 10, 200, 1);
CB2Len      = Param("Duong can bang dai han 2", 129, 10, 300, 1);
EntryTh     = Param("Nguong diem VAO lenh (Mua)", 1.25, 0.5, 3, 0.05);
ExitTh      = Param("Nguong diem RA lenh (Ban, so duong)", 1.5, 0.5, 3, 0.05);
PersistBars = Param("So phien giu tren nguong", 1, 1, 5, 1);
UseADXGate  = ParamToggle("Bat buoc ADX>=18", "Tat|Bat", 1);
ADXGateLv   = Param("Nguong ADX (neu bat)", 18, 10, 40, 1);
CheDoFVG    = ParamList("Che do dieu kien FVG",
              "Thong minh (bo qua khi breakout manh)|Luon BAT|Luon TAT", 0);
// "Thong minh": neu tin hieu la BREAKOUT MANH (diem rat cao + ADX rat cao +
// Volume Gate Ngay1 dat) thi BO QUA doi hoi FVG (gia manh co the khong hoi
// ve vung FVG, cho se lo song). Neu KHONG phai breakout manh (tin hieu binh
// thuong) thi VAN CAN FVG nhu cu, de co diem vao dep hon.
NguongDiemBreakout = Param("Thong minh: diem cao hon nguong bao nhieu la Breakout", 1.0, 0, 3, 0.1);
ATRMult     = Param("He so ATR cho Stop-loss", 2.2, 1, 4, 0.1);
HardStopPct = Param("Stop-loss toi da theo % (chan an toan)", 6, 3, 20, 0.5);
ATRVal = ATR(14);
FVGLookback = Param("FVG het han sau (phien)", 15, 5, 30, 1);

// --- Dieu kien Volume rieng cho MUA NGAY PHIEN DAU chuyen xanh ---
// Neu KHONG thoa man ca 3 dieu kien nay o phien dau tien vua vao vung mua,
// he thong se KHONG mua ngay ma cho sang phien tiep theo (T2) trong dot do
// (van can InFVGZone + ADX Gate nhu binh thuong o T2, khong can lai Volume).
VolMinPctTB20     = Param("Ngay1-Vol: toi thieu so voi TB20 (%)", 50, 0, 300, 5);
VolMinPctHomTruoc = Param("Ngay1-Vol: toi thieu so voi hom truoc (%)", 30, 0, 300, 5);
PocketPivotNhinLai= Param("Ngay1-Vol: Pocket Pivot nhin lai (phien)", 10, 5, 30, 1);

// RS/VNI SOM - dong bo voi ban web (7_Export_LenWeb.afl): can tinh SOM de
// dung lam GATE cho Buy ben duoi. Cong thuc giong het ban "Phan 2: Diem Rank"
// se tinh lai sau (Perf20_Ma/Perf20_VNI) - tinh 2 lan khong sao vi cung 1
// cong thuc, gia tri giong het nhau.
VNI_Close_Som = Foreign("VNINDEX", "C");
RS_SoVoiVNI_Som = (C/Ref(C,-20) - 1 - (VNI_Close_Som/Ref(VNI_Close_Som,-20) - 1)) * 100;
RSVNI_OK = RS_SoVoiVNI_Som > 0;

Tenkan  = (HHV(H,TenkanLen) + LLV(L,TenkanLen)) / 2;
Kijun   = (HHV(H,KijunLen) + LLV(L,KijunLen)) / 2;
SenkouA = Ref((Tenkan+Kijun)/2, -Shift);
SenkouB = Ref((HHV(H,SenkouBLen)+LLV(L,SenkouBLen))/2, -Shift);
CloudTop = Max(SenkouA, SenkouB);
CloudBot = Min(SenkouA, SenkouB);

// KUMO TWIST TUONG LAI - CHI hien thi tham khao. SenkouA/B "goc" (truoc khi
// dich Shift phien ve tuong lai) neu sap cat nhau, nghia la MAY se doi mau
// trong "Shift" phien toi - canh bao som truoc khi gia den do.
SenkouA_Goc = (Tenkan+Kijun)/2;
SenkouB_Goc = (HHV(H,SenkouBLen)+LLV(L,SenkouBLen))/2;
MayTuongLaiDoiChieuTang = SenkouA_Goc > SenkouB_Goc AND Ref(SenkouA_Goc,-1) <= Ref(SenkouB_Goc,-1);
MayTuongLaiDoiChieuGiam = SenkouA_Goc < SenkouB_Goc AND Ref(SenkouA_Goc,-1) >= Ref(SenkouB_Goc,-1);

// FLAT KIJUN / FLAT SENKOU B - CHI hien thi tham khao. Duong "phang" (khong
// doi trong N phien) thuong dong vai tro "nam cham gia" (gia co xu huong bi
// hut ve khi di xa), hoac canh bao pullback sap toi neu Kijun phang duoi 1
// dot tang manh.
SoPhienKiemTraFlat = Param("So phien kiem tra duong phang (Kijun/SenkouB)", 5, 3, 15, 1);
KijunDangPhang = (HHV(Kijun, SoPhienKiemTraFlat) - LLV(Kijun, SoPhienKiemTraFlat)) == 0;
SenkouBDangPhang = (HHV(SenkouB, SoPhienKiemTraFlat) - LLV(SenkouB, SoPhienKiemTraFlat)) == 0;

// TARGET GIA (Price Theory V/N/E) - CHI hien thi tham khao. Can 3 diem A
// (day gan nhat), B (dinh gan nhat sau A), C (day dieu chinh sau B) de tinh:
//   N = C + (B-A)   |   V = B + (B-C)   |   E = B + (B-A)
// Dung vong lap don gian: tim pivot GAN NHAT (khong can toi uu, chi can on
// dinh va dung), voi cua so nhin 5 phien moi ben de xac nhan pivot.
CuaSoPivot = 5;
DiemA = 0; DiemB = 0; DiemC = 0;
ViTriA = 0; ViTriB = 0; ViTriC = 0;
for (i = CuaSoPivot; i < BarCount - CuaSoPivot; i++)
{
    // Tim day pivot (A): thap nhat trong khoang +-CuaSoPivot
    laDayPivot = 1;
    for (k = 1; k <= CuaSoPivot; k++)
    {
        if (L[i] > L[i-k] OR L[i] > L[i+k]) { laDayPivot = 0; break; }
    }
    if (laDayPivot)
    {
        ViTriA[i] = i;
        DiemA[i] = L[i];
    }
    else
    {
        ViTriA[i] = ViTriA[i-1];
        DiemA[i] = DiemA[i-1];
    }

    // Tim dinh pivot (B), CHI tinh neu da co A truoc do
    laDinhPivot = 1;
    for (k = 1; k <= CuaSoPivot; k++)
    {
        if (H[i] < H[i-k] OR H[i] < H[i+k]) { laDinhPivot = 0; break; }
    }
    if (laDinhPivot AND ViTriA[i] > 0 AND i > ViTriA[i])
    {
        ViTriB[i] = i;
        DiemB[i] = H[i];
        ViTriC[i] = 0; // reset C, cho tim lai sau B moi
        DiemC[i] = 0;
    }
    else
    {
        ViTriB[i] = ViTriB[i-1];
        DiemB[i] = DiemB[i-1];
        // Tim day pivot C (sau B, truoc thoi diem hien tai)
        if (laDayPivot AND ViTriB[i-1] > 0 AND i > ViTriB[i-1])
        {
            ViTriC[i] = i;
            DiemC[i] = L[i];
        }
        else
        {
            ViTriC[i] = ViTriC[i-1];
            DiemC[i] = DiemC[i-1];
        }
    }
}

// (Da chuyen Target xuong duoi - gan chinh xac voi dung lenh dang giu,
// xem doan "TARGET CHO LENH HIEN TAI" o gan GiaVaoLenh)

// SANYAKU KOUTEN - "diem chat luong" tong hop 3 dieu kien kinh dien cua
// Ichimoku (KHONG dung de vao lenh - den tre - CHI dung de danh gia do
// "chac chan" cua tin hieu da co). Dem so dieu kien dat trong 3:
//  1. Tenkan cat len Kijun (da co san: TenkanCatLenKijun neu ton tai,
//     neu chua thi tu tinh lai don gian tai day)
//  2. Chikou (gia dong cua hom nay) cao hon dinh 5 phien quanh vi tri Shift
//     phien truoc (dung lai dinh nghia da co o Chikou thong thoang - neu co)
//  3. Gia phá lên tren May (Cloud)
DK1_TenkanCatKijun = Tenkan > Kijun AND Ref(Tenkan,-1) <= Ref(Kijun,-1);
DuDuLieuChoChikou_Sanyaku = BarIndex() >= Shift;
DK2_ChikouThoat = IIf(DuDuLieuChoChikou_Sanyaku, C > Ref(HHV(H,5), -Shift), False);
DK3_PhaLenMay = C > CloudTop AND Ref(C,-1) <= Ref(CloudTop,-1);
SoDiemSanyaku = DK1_TenkanCatKijun + DK2_ChikouThoat + DK3_PhaLenMay;

// TIME THEORY / KIHON SUCHI - CHI hien thi tham khao. Dem so phien tu diem
// pivot GAN NHAT (A hoac B, lay cai gan hon), so sanh voi cac "so co ban"
// kinh dien cua Ichimoku: 9,17,26,33,42,51,65,76,129,172,200,257. Neu dung
// khop 1 trong cac so nay (+-1 phien du sai so), danh dau la "ngay bien doi"
// (henka-bi) - noi co xac suat cao dao chieu/gia toc xu huong.
ViTriPivotGanNhat = Max(ViTriA, ViTriB);
SoPhienTuPivot = BarIndex() - ViTriPivotGanNhat;
DungNgayBienDoi = (Abs(SoPhienTuPivot-9)<=1) OR (Abs(SoPhienTuPivot-17)<=1) OR
    (Abs(SoPhienTuPivot-26)<=1) OR (Abs(SoPhienTuPivot-33)<=1) OR
    (Abs(SoPhienTuPivot-42)<=1) OR (Abs(SoPhienTuPivot-51)<=1) OR
    (Abs(SoPhienTuPivot-65)<=1) OR (Abs(SoPhienTuPivot-76)<=1) OR
    (Abs(SoPhienTuPivot-129)<=1) OR (Abs(SoPhienTuPivot-172)<=1) OR
    (Abs(SoPhienTuPivot-200)<=1) OR (Abs(SoPhienTuPivot-257)<=1);

CanBang1 = (HHV(H,CB1Len)+LLV(L,CB1Len))/2;
CanBang2 = (HHV(H,CB2Len)+LLV(L,CB2Len))/2;
CBTop = Max(CanBang1, CanBang2);
CBBot = Min(CanBang1, CanBang2);

ADXVal = ADX(14);
DIPlus = PDI(14);
DIMinus = MDI(14);
RSIVal = RSI(14);

// ============================================================================
// HE THONG "RSI DA DAC TRUNG + RANK + CONFIDENCE" - BAN GOC 100%, tu thiet
// ke rieng, KHONG sao chep thuat toan K-Nearest-Neighbor/Fisher Discriminant
// cua bat ky tac gia nao. Chi dung toan thong ke pho thong (trung binh
// trong so, do lech chuan, percentile) - day la kien thuc chung, khong
// thuoc ban quyen rieng ai.
// ============================================================================

// --- PHAN 1: RSI DA DAC TRUNG (ket hop nhieu goc nhin tu RSI, thay vi chi
// dung 1 muc RSI don thuan) ---
RSI_Nhanh = RSI(7);
RSI_Cham  = RSI(28);
DoDocRSI_3Phien = RSIVal - Ref(RSIVal, -3);
GiaTocRSI = DoDocRSI_3Phien - Ref(DoDocRSI_3Phien, -3);
ChenhLechNhanhCham = RSI_Nhanh - RSI_Cham;
DoBienDongRSI = StDev(RSIVal, 14);
RSI_Percentile20 = (RSIVal - LLV(RSIVal,20)) / (HHV(RSIVal,20) - LLV(RSIVal,20) + 0.0001) * 100;

// Chuan hoa cac dac trung phu ve thang 0-100 giong RSI de cong duoc:
DoDoc_ChuanHoa      = 50 + Max(-50, Min(50, DoDocRSI_3Phien * 2));
GiaToc_ChuanHoa     = 50 + Max(-50, Min(50, GiaTocRSI * 3));
ChenhLech_ChuanHoa  = 50 + Max(-50, Min(50, ChenhLechNhanhCham));
BienDong_ChuanHoa   = 100 - Min(100, DoBienDongRSI * 5); // bien dong thap = on dinh = diem cao

DungRSIThongMinh = ParamToggle("Loc: Dung RSI da dac trung thay RSI thuong (thu nghiem)", "Tat|Bat", 0);
RSI_ThongMinh = RSIVal*0.40 + DoDoc_ChuanHoa*0.20 + GiaToc_ChuanHoa*0.10 +
                ChenhLech_ChuanHoa*0.15 + RSI_Percentile20*0.10 + BienDong_ChuanHoa*0.05;
RSIVal_ChoDiem = IIf(DungRSIThongMinh, RSI_ThongMinh, RSIVal);
// (Phan 2-Rank, Phan 3-Confidence, Phan 4-Stop thich ung: xem duoi, dat sau
// khi TotalScore/FVGDuLon/BreadthPctNganh/RS_SoVoiVNI da tinh xong)
MFIVal = MFI(14);
AvgVol20 = Ref(MA(V,20),-1);
RelVol = IIf(AvgVol20>0, V/AvgVol20, 1);

// VOLUME-CONFIRMED KUMO BREAKOUT + RETEST - CHI hien thi tham khao. Phat
// hien: (1) gia vua pha len tren May kem Volume dot bien, (2) sau do gia
// dieu chinh ve gan canh May (retest) trong vong 10 phien, van tren May.
NguongVolBreakout = Param("Nguong RelVol de coi la Breakout co Volume", 1.3, 1, 3, 0.1);
PhaLenMayCoVolume = (C > CloudTop) AND (Ref(C,-1) <= Ref(CloudTop,-1)) AND (RelVol >= NguongVolBreakout);
SoNenTuBreakout = BarsSince(PhaLenMayCoVolume);
DangRetestMay = (SoNenTuBreakout > 0) AND (SoNenTuBreakout <= 10) AND
                (C > CloudTop) AND (L <= CloudTop*1.02);

// --- 3 dieu kien Volume cho phien MUA DAU TIEN (khi vua chuyen xanh) ---
VolDatTB20        = RelVol >= (1 + VolMinPctTB20/100);              // >= +50% so voi TB20
VolDatHomTruoc     = IIf(Ref(V,-1)>0, V >= Ref(V,-1)*(1+VolMinPctHomTruoc/100), False); // >= +30% so voi hom truoc
MaxVolNgayGiam10  = Ref(HHV(IIf(C<Ref(C,-1), V, 0), PocketPivotNhinLai), -1); // vol lon nhat cac ngay giam trong N phien truoc do
VolDatPocketPivot = V > MaxVolNgayGiam10;                            // vuot vol ngay giam manh nhat (tinh than Pocket Pivot)
VolumeGateNgayDau = VolDatTB20 AND VolDatHomTruoc AND VolDatPocketPivot;

TrendScore = IIf(C>CloudTop,1, IIf(C<CloudBot,-1,0))
           + IIf(C>CBTop,1, IIf(C<CBBot,-1,0))
           + IIf(Tenkan>Kijun,0.5,-0.5)
           + IIf(ADXVal>25, IIf(DIPlus>DIMinus,0.5,-0.5), 0);
MomScore = IIf(RSIVal>70,-0.5, IIf(RSIVal<30,0.5, IIf(RSIVal>50,0.5,-0.5)));
MFScore = IIf(MFIVal>80,-0.5, IIf(MFIVal<20,0.5, IIf(MFIVal>50,0.5,-0.5)))
        + IIf(RelVol>1.5,0.5, IIf(RelVol<0.5,-0.3,0));
TotalScore = TrendScore*1.5 + MFScore*1.2 + MomScore*1.0;

InFVGZone = 0;
for (i = 2; i < BarCount; i++)
{
    if (H[i-2] < L[i])
    {
        gapBot = H[i-2]; gapTop = L[i];
        expireAt = Min(i + FVGLookback, BarCount-1);
        for (j = i; j <= expireAt; j++)
        {
            if (L[j] < gapBot) break;
            if ((L[j] <= gapTop AND L[j] >= gapBot) OR (C[j] <= gapTop AND C[j] >= gapBot))
                InFVGZone[j] = 1;
        }
    }
}

// FVG - UU TIEN VUNG LON SO VOI ATR (da xac nhan qua Backtest that: PF tang
// dong deu ca 12 nam va 6 nam gan nhat, MaxDD giam ro ret). Vung FVG qua nho
// so voi bien dong binh thuong cua ma (ATR) bi coi la "nhieu", khong tinh
// la du dieu kien du dang "trong vung".
DoLonSoATR_FVG = 0;
for (i = 2; i < BarCount; i++)
{
    if (H[i-2] < L[i])
    {
        gapBot = H[i-2]; gapTop = L[i];
        gapSize = gapTop - gapBot;
        atrLucHinhThanh = ATRVal[i];
        tySoLonATR = IIf(atrLucHinhThanh>0, gapSize/atrLucHinhThanh, 0);
        expireAt = Min(i + FVGLookback, BarCount-1);
        for (j = i; j <= expireAt; j++)
        {
            if (L[j] < gapBot) break;
            if ((L[j] <= gapTop AND L[j] >= gapBot) OR (C[j] <= gapTop AND C[j] >= gapBot))
                if (tySoLonATR > DoLonSoATR_FVG[j]) DoLonSoATR_FVG[j] = tySoLonATR;
        }
    }
}
NguongDiemFVGMem = Param("FVG: Nguong ty le lon/ATR toi thieu (da chot ~0.6)", 0.6, 0.1, 2, 0.05);
FVGDuLon = DoLonSoATR_FVG >= NguongDiemFVGMem;

MatThanWarning = 0;
for (i = 5; i < BarCount-5; i++)
{
    isPivotHigh = 1;
    for (k = 1; k <= 5; k++)
        if (H[i] < H[i-k] OR H[i] < H[i+k]) { isPivotHigh = 0; break; }
    if (isPivotHigh AND H[i] > CloudTop[i])
    {
        enteredAt = -1;
        limitJ = Min(i+26, BarCount-1);
        for (j = i+1; j <= limitJ; j++)
            if (L[j] <= CloudTop[i] AND H[j] >= CloudBot[i]) { enteredAt = j; break; }
        if (enteredAt > 0 AND (BarCount-1-enteredAt) <= 5)
        {
            brokeAbove = 0;
            limitK = Min(enteredAt+5, BarCount-1);
            for (k = enteredAt; k <= limitK; k++)
                if (C[k] > Tenkan[k]) { brokeAbove = 1; break; }
            if (!brokeAbove)
                for (k = enteredAt; k <= limitK; k++)
                    MatThanWarning[k] = 1;
        }
    }
}

Above = TotalScore >= EntryTh;

// ---------------- VUNG THAM GIA THEM (CHI THAM KHAO, KHONG PHAI TIN HIEU MUA) ----------------
// Danh cho KHACH HANG da lo diem Mua ban dau nhung van muon tham gia - hien
// thi khi xu huong CON TOT (tren May + tren duong can bang dai han) nhung gia dang DIEU
// CHINH ve gan Tenkan/Kijun (vung ho tro dong). KHONG dua vao Buy/Sell that,
// chi la thong tin tu van bo sung tren Card.
XuHuongConTot = (C > CloudTop) AND (C > CBTop);
DangDieuChinhVeTenkan = (C <= Tenkan*1.015) AND (C >= Tenkan*0.98);
// (Da bo tinh nang Vung tham gia them)
// dung Buy de kiem tra "da tung Mua trong dot nay chua".
ConsecutiveAbove = Sum(Above, PersistBars) == PersistBars;
VuaVaoVungMua = Above AND NOT Ref(Above,-1); // phien dau tien cua dot tren nguong (moi chuyen xanh)
// TurnedGreenRaw khong con dung (da thay bang vong lap ben duoi cho phep
// mua muon hon trong cung dot) - giu ConsecutiveAbove de vong lap dung toi.
BoQuaADXNeuDiemManh = Param("Bo qua ADX Gate neu |TotalScore| >= muc nay", 2.5, 1.5, 4, 0.1);
ADXGateOk = IIf(UseADXGate, (ADXVal >= ADXGateLv) OR (Abs(TotalScore) >= BoQuaADXNeuDiemManh), 1);

// BREAKOUT MANH: diem vuot xa nguong + ADX rat cao + da co xac nhan Volume
// Ngay1 (VolumeGateNgayDau) -> coi la tin hieu du manh de KHONG can doi FVG.
BreakoutManh = (TotalScore >= EntryTh + NguongDiemBreakout);

InFVGZone_H3 = InFVGZone AND FVGDuLon;  // trong vung VA du lon so ATR (H3)
InFVGZoneOk = IIf(CheDoFVG=="Luon TAT", 1,
              IIf(CheDoFVG=="Luon BAT", InFVGZone_H3,
              IIf(BreakoutManh AND VolumeGateNgayDau, 1, InFVGZone_H3))); // che do Thong minh (mac dinh)
// NANG CAP (da kiem chung Python: PF 2.46->2.62, tong 1377->1417 giai doan
// tot; chi kem nhe ~4.5 diem % giai doan kho): CHO PHEP Mua vao BAT KY ngay
// nao trong CUNG 1 dot tren nguong (khong chi dung ngay dau tien), mien FVG
// mo dung luc do - nhung CHI DUNG 1 LAN moi dot (tranh lap lai loi da hoc
// truoc: "chot nhieu lan" lam sai lech). Dung vong lap tuong minh de kiem
// soat chac chan trang thai "da mua trong dot nay chua".
TurnedGreen = 0;
DaMuaDotNay = 0;
for (i = 1; i < BarCount; i++)
{
    if (!ConsecutiveAbove[i])
    {
        DaMuaDotNay[i] = 0;
    }
    else
    {
        // Neu la phien dau tien cua dot (VuaVaoVungMua): bat buoc them VolumeGateNgayDau.
        // Tu phien thu 2 tro di trong cung dot (van chua mua): khong can Volume Gate nua,
        // chi can InFVGZone + ADX Gate nhu cu -> tuc "mua vao phien T2" khi Ngay1 khong dat Volume.
        DuDieuKienVolumeNgayDau = !VuaVaoVungMua[i] OR VolumeGateNgayDau[i];
        if (ConsecutiveAbove[i] AND InFVGZoneOk[i] AND ADXGateOk[i] AND DuDieuKienVolumeNgayDau AND !DaMuaDotNay[i-1])
        {
            TurnedGreen[i] = 1;
            DaMuaDotNay[i] = 1;
        }
        else
        {
            DaMuaDotNay[i] = DaMuaDotNay[i-1];
        }
    }
}

SoPhienBanXacNhan = Param("So phien Ban can xac nhan lien tuc", 3, 1, 5, 1);
ZoneSell = TotalScore <= -ExitTh;
ZoneSellXacNhan = Sum(ZoneSell, SoPhienBanXacNhan) == SoPhienBanXacNhan;
TurnedPink = ZoneSellXacNhan AND NOT Ref(ZoneSellXacNhan,-1);

// DONG BO tu file Backtest: tuy chon Ban NGAY neu diem qua sau (mac dinh TAT)
BatBanNgayKhiSau = ParamToggle("Bat Ban NGAY neu diem qua sau (bo qua cho)", "Tat|Bat", 0);
NguongBanNgay = Param("Nguong diem qua SAU de Ban ngay (khong cho)", 2.0, 1.5, 4, 0.1);
ZoneSellSau = TotalScore <= -NguongBanNgay;
TurnedPinkSau = ZoneSellSau AND NOT Ref(ZoneSellSau,-1);

TurnedPink = IIf(BatBanNgayKhiSau,
    (ZoneSellXacNhan AND NOT Ref(ZoneSellXacNhan,-1)) OR TurnedPinkSau,
    ZoneSellXacNhan AND NOT Ref(ZoneSellXacNhan,-1));

// VN30 - CAP NHAT dung theo ky co cau thang 7/2026 (nguon: HOSE, xac nhan
// qua cong ty chung khoan AAS 22/07/2026). BSR, BVH, POW moi vao; DGC, LPB,
// SHB da bi loai khoi VN30 (chuyen xuong Midcap ben duoi).
VN30List = "ACB,BID,BSR,BVH,CTG,FPT,GAS,GVR,HDB,HPG,"+
    "MBB,MSN,MWG,PLX,POW,SAB,SSB,SSI,STB,TCB,"+
    "TPB,VCB,VHM,VIB,VIC,VJC,VNM,VPB,VPL,VRE";
InVN30 = StrFind( "," + VN30List + ",", "," + Name() + "," ) > 0;

// VNMIDCAP - 70 ma con lai. LUU Y: chua xac nhan 100% tung ma rieng le, la
// danh sach ke thua tu du lieu cu, chi dieu chinh 3 ma vua chuyen nhom.
// Dong bo them 16 ma moi voi 7_Export_LenWeb.afl (mo rong ca HNX/UPCOM).
VNMidCapList = "ANV,BCM,BMP,BSI,BWE,CII,CMG,CTD,CTR,CTS,"+
    "DBC,DCM,DGW,DIG,DPM,DSE,DXG,DXS,EIB,EVF,"+
    "FRT,FTS,GEE,GEX,GMD,HAG,HCM,HDC,HDG,HHV,"+
    "HSG,HT1,IMP,KBC,KDC,KDH,KOS,MSB,NAB,NKG,"+
    "NLG,NT2,NVL,OCB,PAN,PC1,PDR,PHR,PNJ,PVD,"+
    "PVT,REE,SBT,SCS,SIP,SJS,SZC,TCH,VCG,VCI,"+
    "VGC,VHC,VIX,VND,VPI,VSC,VTP,DGC,LPB,SHB,MSR,"+
    "TMS,MBS,SHS,BVS,PVS,OIL,VGI,FOX,ACV,VGT,"+
    "NTP,QNS,LTG,HNG,MCH,PVI,TCX,VCK";
InVNMidCap = StrFind( "," + VNMidCapList + ",", "," + Name() + "," ) > 0;

VN100List = VN30List + "," + VNMidCapList;
InVN100 = StrFind( "," + VN100List + ",", "," + Name() + "," ) > 0;

// VNSMALLCAP - 202 ma. Tinh bang VNAllshare (302 ma, cong bo chinh thuc HOSE
// ky 1/2026, qua Vietstock) TRU DI VN100 (100 ma).
// Dong bo them ~70 ma moi voi 7_Export_LenWeb.afl (mo rong ca HNX/UPCOM).
VNSmallCapList = "AAA,AAM,ABS,ABT,ACC,ACL,ADG,ADP,ADS,AGG,"+
    "AGR,APG,APH,ASM,ASP,AST,BAF,BCE,BFC,BIC,"+
    "BKG,BMC,BMI,BRC,BTP,C32,CCC,CCL,CDC,CHP,"+
    "CIG,CKG,CLL,CMX,CNG,CRC,CRE,CSM,CSV,CTF,"+
    "CTI,D2D,DAH,DBD,DC4,DCL,DHA,DHC,DHM,DLG,"+
    "DMC,DPG,DPR,DRC,DRL,DSC,DSN,DTA,DVP,DXV,"+
    "ELC,EVE,EVG,FCM,FCN,FIR,FIT,FMC,GDT,GEG,"+
    "GIL,GSP,HAH,HAP,HAR,HAX,HCD,HHP,HHS,HID,"+
    "HII,HMC,HPX,HQC,HSL,HTG,HTI,HTN,HTV,HUB,"+
    "HVH,ICT,IDI,IJC,ILB,ITC,ITD,JVC,KHG,KHP,"+
    "KMR,KSB,LAF,LBM,LCG,LGL,LHG,LIX,LSS,MCM,"+
    "MCP,MHC,MIG,MSH,NAF,NAV,NBB,NCT,NHA,NHH,"+
    "NNC,NO1,NSC,NTL,OGC,ORS,PAC,PET,PGC,PHC,"+
    "PIT,PLP,PPC,PTB,PTC,PTL,PVP,QCG,RAL,RYG,"+
    "SAM,SAV,SBG,SCR,SFC,SFI,SGN,SGR,SGT,SHA,"+
    "SHI,SJD,SKG,SMB,ST8,STK,SVD,SVT,SZL,TCI,"+
    "TCL,TCM,TCO,TCT,TDC,TDG,TDH,TDP,TEG,THG,"+
    "TIP,TLD,TLG,TLH,TMT,TN1,TNH,TNI,TNT,TRC,"+
    "TSC,TTA,TTF,TV2,TVB,TVS,UIC,VCA,VDS,VFG,"+
    "VIP,VNL,VOS,VPG,VPH,VPS,VRC,VSI,VTB,VTO,"+
    "YBM,YEG,DHG,TRA,VCF,HVN,SVC,CAV,DQC,"+
    "PGI,NTC,VSH,SPM,TVT,STG,VNA,C47,KLB,BVB,"+
    "VAB,CEO,L18,HLD,EVS,APS,TVC,PSI,BMS,SBS,"+
    "WSS,AAS,NVB,ABB,BAB,TVN,SMC,VGS,POM,GDA,"+
    "PVC,PLC,PVB,PSD,ABI,VNR,PRE,PTI,IDC,IDV,"+
    "FOC,TV1,QTP,HND,PVG,RIC,SAS,LDP,DHT,TNG,"+
    "DXP,PHP,NET,LAS,HBC,DRI,KSV,HGM,SLS,TAR,HUT";
InVNSmallCap = StrFind( "," + VNSmallCapList + ",", "," + Name() + "," ) > 0;
// GHI CHU: Da BO dieu kien bat buoc "phai nam trong VN100List" o Buy ben duoi
// (xem dong "Buy = TurnedGreen AND ChiTrong12NamGanNhat AND BreadthOk15").
// Bien InVN100 van duoc tinh & giu lai (khong dung) phong khi can dung lai sau nay.

// GIOI HAN SO NAM GAN NHAT - chinh truc tiep trong bang Parameters cua
// AmiBroker (khong can sua code). Dat = 0 hoac so nam rat lon (vd 99) neu
// muon test TOAN BO du lieu co san, khong gioi han.
SoNamGanNhat = Param("So nam gan nhat de test (0 = khong gioi han)", 12, 0, 99, 1);
SoPhienUocTinh = IIf(SoNamGanNhat<=0, BarCount, SoNamGanNhat * 250);
ChiTrong12NamGanNhat = IIf(SoNamGanNhat<=0, True,
    BarIndex() >= (LastValue(BarIndex()) - SoPhienUocTinh));

// BAN BACKTEST RIENG - GIOI HAN ca VN100 LAN 12 nam gan nhat, dam bao so
// sanh cong bang voi cac lan Backtest truoc do (deu dung 12 nam).
// ---------------- BREADTH GATE 15 NGANH DAY DU (tuy chon Bat/Tat) ----------------
BatBreadthGate = ParamToggle("Bat Breadth Gate 15 Nganh", "Tat|Bat", 1);
// (Da bo BreadthMinPct - khong con dung trong ban "mem" nay, thay bang
// NguongManh/NguongYeu ben duoi)
NguongManh = Param("Nguong Breadth NGANH MANH (100% ty trong)", 60, 30, 90, 5);
NguongYeu = Param("Nguong Breadth NGANH YEU (duoi muc nay)", 30, 10, 60, 5);

function TinhBreadth(DanhSachMa, SoLuong)
{
    dem = 0;
    for (i = 0; i < SoLuong; i++)
    {
        tk = StrExtract(DanhSachMa, i);
        px = LastValue(Foreign(tk, "C"));
        maVal = LastValue(MA(Foreign(tk,"C"), 50));
        if (px > maVal) dem = dem + 1;
    }
    return dem / SoLuong * 100;
}

DS_NganHang = "ACB,BID,BVB,CTG,EIB,HDB,KLB,LPB,MBB,MSB,NAB,OCB,SHB,SSB,STB,TCB,TPB,VAB,VBB,VCB,VIB,VPB,NVB,ABB,BAB";
DS_BDS = "AGG,ASM,CCL,CII,CKG,CRE,DIG,DXG,DXS,EVG,FDC,FIR,HAR,HDC,HDG,HPX,HQC,HTN,ITC,KDH,KHG,KOS,LDG,LGL,NBB,NHA,NLG,NTL,NVL,PDR,PTL,QCG,SCR,SGR,SJS,TCH,TDC,TDH,THG,TNT,VHM,VIC,VPH,VPI,VRC,VRE,BCM,D2D,GVR,KBC,LHG,NTC,PHR,SIP,SZC,SZL,TIP,TIX,VGC,IJC,CEO,L18,HLD,HUT,IDC,IDV";
DS_ChungKhoan = "AGR,APG,BSI,CTS,DSC,DSE,EVF,FTS,HCM,ORS,SSI,TVB,TVS,VCI,VDS,VIX,VND,TCI,BVS,EVS,APS,SHS,MBS,TVC,PSI,BMS,SBS,WSS,AAS,TCX,VCK";
DS_BaoHiem = "BIC,BMI,BVH,MIG,PGI,ABI,VNR,PVI,PRE,PTI";
DS_XayDung = "ACC,BCE,C47,CDC,CIG,CTD,CTI,DC4,DPG,DLG,FCM,FCN,HHV,HID,HTI,L10,LCG,LGC,LM8,PHC,PTC,SC5,SRF,VCG,VSI,BMP,C32,CCC,CRC,CVT,DHA,DXV,HCD,HT1,KSB,LBM,MDG,NNC,TCR,TLD,HUB,NO1,NTP,HBC";
DS_ThepKhoangSan = "DTL,HMC,HPG,HSG,NKG,SMC,TLH,VCA,BMC,DHM,PLP,VPG,YBM,TVN,VGS,POM,GDA,KSV,HGM";
DS_DauKhiDienNuoc = "ASP,BSR,CNG,COM,GAS,PGC,PGD,PLX,PVD,SFC,BTP,BWE,CHP,CLW,DRL,GEG,GHC,HNA,KHP,NT2,PC1,PGV,POW,PPC,REE,S4A,SBA,SHP,SJD,TBC,TDM,TDW,TMP,TTA,TV2,VPD,VSH,TDG,PIT,PVC,OIL,PVS,PLC,PVB,TV1,QTP,HND,PVG";
DS_HoaChatCaoSu = "BFC,CSV,DCM,DGC,DPM,HII,SFG,VFG,BRC,CSM,DPR,DRC,HRC,SRC,TNC,TRC,AAA,APH,TDP,TPC,NAV,NHH,VPS,NET,LAS,DRI";
DS_ThucPhamNongSan = "BBC,BHN,CLC,KDC,LSS,MCH,MSN,NAF,SAB,SBT,VCF,VNM,AAN,ABS,ANT,BAF,DBC,HAG,HSL,NSC,PAN,SSC,TSC,AAM,ABT,ACL,ANV,CMX,FMC,IDI,VHC,LAF,LIX,MCM,SMB,QNS,SLS,LTG,TAR,HNG";
DS_BanLeOto = "ADP,CMV,DGW,FRT,MWG,PET,PNJ,ST8,CTF,HAX,HHS,HTL,SVC,TMT,TLG,PTB,PSD";
DS_DetMayGo = "AAT,ADS,EVE,GIL,HTG,KMR,MSH,STK,SVD,TCM,TVT,ACG,BKG,GDT,GTA,SAV,TTF,DHC,HHP,MCP,SVI,VID,TNG,VGT";
DS_LogisticsVanTai = "CLL,DVP,GMD,HAH,HTV,ILB,NCT,PDN,QNP,SCS,SFI,SGN,STG,TCL,TCO,TMS,VSC,VTP,GSP,HVN,PJT,PVP,PVT,SKG,VJC,VNL,VNS,VOS,VTO,MHC,VIP,DXP,PHP";
DS_CongNgheVienThong = "ADG,CMG,ELC,FPT,ICT,ITD,SVT,CTR,HAS,TSA,VTB,ABR,PNC,YEG,VGI,FOX,FOC";
DS_YTe = "DBD,DBT,DCL,DHG,DMC,IMP,JVC,OPC,SPM,TNH,TRA,VDP,VMD,LDP,DHT";
DS_ThietBiDienDuLich = "CAV,DQC,GEE,GEL,GEX,PAC,RAL,SHA,SHI,TYA,AST,DAH,DSN,NVT,OGC,TCT,VNG,VPL,RIC,ACV,SAS";

Breadth_NganHang = TinhBreadth(DS_NganHang, 25);
Breadth_BDS = TinhBreadth(DS_BDS, 66);
Breadth_ChungKhoan = TinhBreadth(DS_ChungKhoan, 31);
Breadth_BaoHiem = TinhBreadth(DS_BaoHiem, 10);
Breadth_XayDung = TinhBreadth(DS_XayDung, 44);
Breadth_ThepKhoangSan = TinhBreadth(DS_ThepKhoangSan, 19);
Breadth_DauKhiDienNuoc = TinhBreadth(DS_DauKhiDienNuoc, 48);
Breadth_HoaChatCaoSu = TinhBreadth(DS_HoaChatCaoSu, 26);
Breadth_ThucPhamNongSan = TinhBreadth(DS_ThucPhamNongSan, 40);
Breadth_BanLeOto = TinhBreadth(DS_BanLeOto, 17);
Breadth_DetMayGo = TinhBreadth(DS_DetMayGo, 24);
Breadth_LogisticsVanTai = TinhBreadth(DS_LogisticsVanTai, 33);
Breadth_CongNgheVienThong = TinhBreadth(DS_CongNgheVienThong, 17);
Breadth_YTe = TinhBreadth(DS_YTe, 15);
Breadth_ThietBiDienDuLich = TinhBreadth(DS_ThietBiDienDuLich, 21);

Breadth_TB_Chung = (Breadth_NganHang+Breadth_BDS+Breadth_ChungKhoan+Breadth_BaoHiem+Breadth_XayDung
    +Breadth_ThepKhoangSan+Breadth_DauKhiDienNuoc+Breadth_HoaChatCaoSu+Breadth_ThucPhamNongSan
    +Breadth_BanLeOto+Breadth_DetMayGo+Breadth_LogisticsVanTai+Breadth_CongNgheVienThong
    +Breadth_YTe+Breadth_ThietBiDienDuLich) / 15;

MaTenBG = Name();
TrongNH = StrFind("," + DS_NganHang + ",", "," + MaTenBG + ",") > 0;
TrongBDS = StrFind("," + DS_BDS + ",", "," + MaTenBG + ",") > 0;
TrongCK = StrFind("," + DS_ChungKhoan + ",", "," + MaTenBG + ",") > 0;
TrongBH = StrFind("," + DS_BaoHiem + ",", "," + MaTenBG + ",") > 0;
TrongXD = StrFind("," + DS_XayDung + ",", "," + MaTenBG + ",") > 0;
TrongTK = StrFind("," + DS_ThepKhoangSan + ",", "," + MaTenBG + ",") > 0;
TrongDK = StrFind("," + DS_DauKhiDienNuoc + ",", "," + MaTenBG + ",") > 0;
TrongHC = StrFind("," + DS_HoaChatCaoSu + ",", "," + MaTenBG + ",") > 0;
TrongTP = StrFind("," + DS_ThucPhamNongSan + ",", "," + MaTenBG + ",") > 0;
TrongBL = StrFind("," + DS_BanLeOto + ",", "," + MaTenBG + ",") > 0;
TrongDM = StrFind("," + DS_DetMayGo + ",", "," + MaTenBG + ",") > 0;
TrongLG = StrFind("," + DS_LogisticsVanTai + ",", "," + MaTenBG + ",") > 0;
TrongCN = StrFind("," + DS_CongNgheVienThong + ",", "," + MaTenBG + ",") > 0;
TrongYT = StrFind("," + DS_YTe + ",", "," + MaTenBG + ",") > 0;
TrongTB = StrFind("," + DS_ThietBiDienDuLich + ",", "," + MaTenBG + ",") > 0;

BreadthPctNganh = IIf(TrongNH, Breadth_NganHang,
                   IIf(TrongBDS, Breadth_BDS,
                   IIf(TrongCK, Breadth_ChungKhoan,
                   IIf(TrongBH, Breadth_BaoHiem,
                   IIf(TrongXD, Breadth_XayDung,
                   IIf(TrongTK, Breadth_ThepKhoangSan,
                   IIf(TrongDK, Breadth_DauKhiDienNuoc,
                   IIf(TrongHC, Breadth_HoaChatCaoSu,
                   IIf(TrongTP, Breadth_ThucPhamNongSan,
                   IIf(TrongBL, Breadth_BanLeOto,
                   IIf(TrongDM, Breadth_DetMayGo,
                   IIf(TrongLG, Breadth_LogisticsVanTai,
                   IIf(TrongCN, Breadth_CongNgheVienThong,
                   IIf(TrongYT, Breadth_YTe,
                   IIf(TrongTB, Breadth_ThietBiDienDuLich,
                   Breadth_TB_Chung)))))))))))))));

// CAN DOI: thay vi CHAN CUNG (co/khong), GIAM TY TRONG theo 3 muc - van cho
// tham gia ngay ca nganh yeu (chi it von hon), khong bo lo hoan toan co hoi.
// Da kiem chung Python: Sharpe giu nguyen (0.73), Drawdown con em hon.
// SUA LOI: truoc day dung 100/50/20 (% TUYET DOI cua von) - khien 1 lenh
// nganh manh co the "nuot het" von, lam cac lenh sau khong con tien du du
// con "cho trong" (chua du 8 vi the). Sua lai dung CACH: nhan he so vao
// dung moc chuan 100/8=12.5% (giong ban goc), khong dung % tuyet doi.
MocChuan = 100/8; // 12.5%
TyTrongTheoNganh = IIf(BatBreadthGate,
    IIf(BreadthPctNganh>=NguongManh, MocChuan*1.0,
    IIf(BreadthPctNganh>=NguongYeu, MocChuan*0.5,
    MocChuan*0.2)),
    MocChuan);
BreadthOk15 = 1; // khong con chan cung nua, luon cho phep (chi doi ty trong)

// THANH KHOAN GATE + GIA TOI THIEU GATE - dong bo voi ban web
// (7_Export_LenWeb.afl): loai co phieu khoi luong qua thap hoac gia "tra"
// (duoi 10 nghin dong) ra khoi tin hieu MUA, du diem so co the dat nguong.
NguongKLTB20ToiThieu = Param("Nguong KL trung binh 20 phien toi thieu (co phieu)", 100000, 0, 5000000, 10000);
KhoiLuongTB20 = MA(V,20);
ThanhKhoanKL_Ok = KhoiLuongTB20 >= NguongKLTB20ToiThieu;
NguongGiaToiThieu = Param("Nguong gia toi thieu de duoc coi la giao dich duoc (nghin dong)", 10, 0, 100, 1);
GiaToiThieuOk = C >= NguongGiaToiThieu;

// RS SO VOI VN-INDEX <= 0: van bao MUA nhung chi GIAI NGAN 1 PHAN (mua tham
// do) - dong bo voi 7_Export_LenWeb.afl. Tat toggle de tro ve cach cu (chan han).
ChoPhepMuaKhiRSAm = ParamToggle("RS<=0: van bao MUA nhung chi giai ngan 1 phan (Tat = chan han nhu cu)", "Tat|Bat", 1);
HanBoSungPhien = Param("Han bo sung phan con lai sau khi mua tham do (phien)", 5, 1, 20, 1);
RSGateOk = IIf(ChoPhepMuaKhiRSAm, 1, RSVNI_OK);

Buy = TurnedGreen AND ChiTrong12NamGanNhat AND BreadthOk15 AND RSGateOk AND ThanhKhoanKL_Ok AND GiaToiThieuOk;

// QUYET DINH CUOI CUNG sau 2 lan that bai: KHONG gop Stop-loss vao Sell
// bang vong lap nua (da gay loi 2 lan lien tiep). Dung cau truc DON GIAN,
// ON DINH NHAT: Sell = tin hieu (TurnedPink/MatThan) + T+2.5. Rieng Stop-loss
// la lop THAT SU trong Backtest qua ApplyStop() (xem ben duoi, luon dung),
// con tren Card CHI la dong canh bao THAM KHAO, KHONG tu doi trang thai.
// Mat Than gio la CHI TIEU PHU (hien thi tham khao tren Card), KHONG con
// quyet dinh Mua/Ban - da xac nhan qua Backtest that.
SellRaw = TurnedPink;
DuT2 = BarsSince(Buy) >= 2;
SellTinHieu = SellRaw AND DuT2;

// ============================================================================
// CHE DO VAO LENH / STOP-LOSS / CHOT LOI - CONG TAC (MAC DINH = TAT = CU)
//   TAT (cu):  vao lenh tai GIA DONG CUA phien co tin hieu; SL = gia vao - nho
//              hon cua (ATRMult x ATR, HardStopPct%); TP1-3 = 3 khang cu, san
//              5/10/15% tren gia vao.
//   BAT (moi): "cham diem mua la mua" - neu phien MUA cung la phien diem vua
//              chuyen sang vung Mua thi vao lenh tai MOC CHUYEN MUA (gia vuot
//              may/duong can bang dai han; neu nhay von thi gia mo cua; khong cao hon gia dong
//              cua), cac phien con lai van vao tai gia dong cua. SL dat DUOI CAU
//              TRUC (may/duong can bang dai han vua vuot, day nen chuyen mua, hoac Kijun) tru
//              dem ATR, kep trong [SLToiThieuPct, HardStopPct]% duoi gia vao;
//              khong co cau truc hop le thi dung SL cu. San TP tinh tu gia vao.
//   LUU Y: Backtest o che do MOI lac quan hon (mua tai moc thap hon gia dong cua
//   nhung van chi tinh cac phien da duoc gia dong cua xac nhan diem) - chi nen
//   dung de SO SANH voi che do cu, khong coi la ket qua giao dich thuc te.
// ============================================================================
CheDoMoc = ParamToggle("CHE DO MOI: vao tai moc chuyen mua + SL cau truc (Tat = cu)", "Tat|Bat", 1);
KieuSLCauTruc = ParamList("Che do MOI - SL dat duoi", "Moc vua vuot (may / duong can bang dai han)|Day nen chuyen mua|Kijun", 0);
DemSLtheoATR = Param("Che do MOI - dem duoi moc SL (x ATR)", 0.3, 0, 2, 0.1);
SLToiThieuPct = Param("Che do MOI - SL cach gia vao toi thieu (%)", 2, 0.5, 6, 0.5);
SLKieuMoc = KieuSLCauTruc == "Moc vua vuot (may / duong can bang dai han)";
SLKieuDay = KieuSLCauTruc == "Day nen chuyen mua";

// STOP-LOSS: CHAM LA CAT (Bat, mac dinh) - khop Backtest: ApplyStop() cat lenh ngay khi gia thap nhat cua phien <= Stop-loss,
// bat ke diem so. Tat = kieu cu "chi cat khi diem cung am" (tin hieu web/Zalo se KHONG bao Ban du gia da cham Stop-loss neu diem con duong,
// trong khi Backtest van cat -> lech nhau; ket qua Backtest 2006-2026: cat khi cham Stop-loss tot hon giu tiep).
SLChamLaCat = ParamToggle("Stop-loss: CHAM LA CAT nhu Backtest (Tat = chi cat khi diem am)", "Tat|Bat", 1);

KhongCoMoc = 1e10;
// Muc gia vua bi vuot o phien chuyen mua (may / duong can bang dai han) - dung ca cho cot
// "moc kich hoat" hien thi tren web va cho che do MOI o tren.
VuotMayBar = C > CloudTop AND Ref(C,-1) <= Ref(CloudTop,-1);
VuotCBBar = C > CBTop AND Ref(C,-1) <= Ref(CBTop,-1);
MucVuotBar = IIf(VuotMayBar AND VuotCBBar, Max(CloudTop, CBTop),
             IIf(VuotMayBar, CloudTop,
             IIf(VuotCBBar, CBTop, C)));
LoaiMocBar = IIf(VuotMayBar AND VuotCBBar, 3, IIf(VuotMayBar, 1, IIf(VuotCBBar, 2, 0)));
// Gia vao tai moc: khong thap hon gia MO CUA neu nhay von qua moc (khong the mua
// thap hon gia mo cua), khong cao hon gia dong cua.
GiaKichHoatBar = Max(MucVuotBar, Min(O, C));
// Co so dat SL: muc THAP hon trong 2 muc cung bi vuot (chua du "tho" cho ca 2).
MocDatSLBar = IIf(VuotMayBar AND VuotCBBar, Min(CloudTop, CBTop),
              IIf(VuotMayBar, CloudTop,
              IIf(VuotCBBar, CBTop, KhongCoMoc)));
MocDatSLTaiSwitch = ValueWhen(VuaVaoVungMua, MocDatSLBar, 1);
DayNenTaiSwitch = ValueWhen(VuaVaoVungMua, L, 1);

// GIA VAO va STOP-LOSS neu vao lenh tai tung phien (Cu: gia vao = C, SL nhu cu).
GiaVaoBar = IIf(CheDoMoc AND VuaVaoVungMua, GiaKichHoatBar, C);
BaseSL = IIf(SLKieuMoc, MocDatSLTaiSwitch, IIf(SLKieuDay, DayNenTaiSwitch, Kijun));
BaseSLHopLe = BaseSL > 0 AND BaseSL < GiaVaoBar;
SLCauTruc = Min(BaseSL - DemSLtheoATR * ATRVal, GiaVaoBar * (1 - SLToiThieuPct/100));
SLCauTruc = Max(SLCauTruc, GiaVaoBar * (1 - HardStopPct/100));
SLTheoATR6 = GiaVaoBar - Min(ATRVal * ATRMult, GiaVaoBar * (HardStopPct/100));
StopVaoBar = IIf(CheDoMoc AND BaseSLHopLe, SLCauTruc, SLTheoATR6);

// ============================================================================
// BAO VE LAI SAU KHI CHOT LOI  +  MUA LAI  (2 CONG TAC, MAC DINH = TAT = CU)
// ----------------------------------------------------------------------------
// BAO VE LAI: sau khi lenh cham TP (TP1/TP2 dong bang luc vao) dat them 1 muc SL bao ve.
// Chi co tac dung khi BAT, o che do Tat moi thu giu nguyen nhu cu:
//   "Hoa von sau TP2":      sau khi cham TP2, SL = gia vao (khong con nguy co lo).
//   "Rong tu dinh sau TP1": sau khi cham TP1, SL = dinh cao nhat tu luc vao tru
//                           BaoVeRongPct% (rong de khong bi cat oan boi nhip hoi).
// Khac Stop-loss thuong (chi ban khi diem cung am), muc bao ve la SL GIA thuan tuy:
// cham la ban. Backtest khop tai gia SL (hoac gia mo cua neu nhay von).
// MUA LAI: sau khi da BAN khong lo, neu xu huong con tang ma gia hoi ve ho tro (Kijun
// hoac can bang dai han duoi) roi bat len => vao lenh MOI tai gia dong cua, SL rieng duoi
// ho tro. Dieu kien: lan ban truoc khong lo; diem >= DiemToiThieuMuaLai; gia tren may; nen
// bat len (dong > mo, dong > dong hom qua); trong han HanMuaLaiPhien phien ke tu lan ban
// truoc; va cac bo loc cua Buy (12 nam, thanh khoan, gia toi thieu, RS). Chua backtest -
// chi dung de SO SANH voi che do cu.
// ============================================================================
KieuBaoVeLai = ParamList("Bao ve lai sau khi chot loi", "Tat|Hoa von sau TP2|Rong tu dinh sau TP1", 1);
BaoVeRongPct = Param("Bao ve lai - do rong tu dinh (%)", 20, 5, 40, 1);
BVHoaVon = KieuBaoVeLai == "Hoa von sau TP2";
BVRong = KieuBaoVeLai == "Rong tu dinh sau TP1";
BVBat = BVHoaVon OR BVRong;

// TP1/TP2 dung trong vong lap de biet "da cham TP chua" - CUNG cong thuc voi ChotLoi_TP1/2
// o phan Chot loi phia duoi (neu doi cong thuc TP thi sua CA HAI cho khop).
NGanV = Max(HHV(H, 60), GiaVaoBar * 1.05);
NGiuaV = Max(Max(CBTop, CloudTop), GiaVaoBar * 1.10);
NXaV = Max(HHV(H, 252), GiaVaoBar * 1.15);
TP1Vong = Min(Min(NGanV, NGiuaV), NXaV);
TP3Vong = Max(Max(NGanV, NGiuaV), NXaV);
TP2Vong = NGanV + NGiuaV + NXaV - TP1Vong - TP3Vong;

BatMuaLai = ParamToggle("MUA LAI: mua lai khi hoi ve ho tro trong xu huong tang (Tat = cu)", "Tat|Bat", 1);
KieuHoTroMuaLai = ParamList("Mua lai - ho tro", "Kijun|Can bang dai han (duoi)", 0);
DiemToiThieuMuaLai = Param("Mua lai - diem toi thieu", 0.75, 0, 3, 0.05);
HanMuaLaiPhien = Param("Mua lai - trong vong (phien) sau lan ban truoc", 60, 5, 250, 5);
DoChamHoTroPct = Param("Mua lai - do cham ho tro cho phep (%)", 1, 0, 3, 0.5);
// Khong "duoi gia": gia mua lai khong duoc cao hon gia ban lan truoc qua muc nay (%). Mac dinh 0 =
// chi mua lai khi gia da ve bang/thap hon gia da ban. Dat 50 de tat dieu kien nay.
MuaLaiCaoToiDaPct = Param("Mua lai - toi da cao hon gia ban truoc (%)", 0, -20, 50, 0.5);
SoLanMuaLaiToiDa = Param("Mua lai - so lan lien tiep toi da (tinh tu lan Mua thuong gan nhat)", 2, 1, 10, 1);
HoTroMuaLaiGia = IIf(KieuHoTroMuaLai == "Kijun", Kijun, CBBot);
MuaLaiTinHieu = BatMuaLai AND (HoTroMuaLaiGia > 0)
    AND (L <= HoTroMuaLaiGia * (1 + DoChamHoTroPct/100)) AND (C > HoTroMuaLaiGia)
    AND (C > O) AND (C > Ref(C,-1)) AND (TotalScore >= DiemToiThieuMuaLai) AND (C > CloudTop)
    AND ChiTrong12NamGanNhat AND BreadthOk15 AND RSGateOk AND ThanhKhoanKL_Ok AND GiaToiThieuOk;
// SL do gia CHUYEN MUA (HoTroMuaLaiGia), khong do tu gia dong cua C - xem ghi chu MUA MOI SAU TP3 ben duoi.
SLMuaLaiTho = Min(HoTroMuaLaiGia - DemSLtheoATR * ATRVal, HoTroMuaLaiGia * (1 - SLToiThieuPct/100));
SLMuaLaiTho = Max(SLMuaLaiTho, HoTroMuaLaiGia * (1 - HardStopPct/100));
StopMuaLaiBar = IIf((HoTroMuaLaiGia > 0) AND (HoTroMuaLaiGia < C), SLMuaLaiTho,
                    C - Min(ATRVal * ATRMult, C * (HardStopPct/100)));

// SUA LOI QUAN TRONG: KHONG ExRem(Buy, SellTinHieu) o day nua - vi luc nay
// SellTinHieu CHUA biet ve cac lan Ban do cham Stop-loss, khien ExRem xoa
// NHAM cac tin hieu Mua MOI hop le sau moi lan cat lo (day la nguyen nhan
// "mat nhieu diem mua" da gap). Vong lap ben duoi se TU XU LY dung viec
// "chi vao lenh khi CHUA dang giu", khong can ExRem truoc.

// GOP STOP-LOSS VAO SELL (lan 3, da kiem tra ky thu tu bien truoc khi sua).
// Dung vong lap voi TRANG THAI RIENG (khong dung DangGiuLenhVT ben trong,
// tranh vong lap tu tham chieu - day la nguyen nhan gay loi lan 1).
// ============================================================================
// MUA MOI SAU TP3 (VONG 2) - CHI XUAT/HIEN THI, KHONG DOI Buy/Sell/Backtest
// ----------------------------------------------------------------------------
// Sau khi lenh goc da cham TP3 (chot 85%, con 15% giu chay) ma coi nhu can TIM DIEM MUA MOI, tach rieng khoi vi the cu:
// khi gia hoi ve ho tro (Kijun hoac can bang dai han duoi), nen xanh bat len, diem con >= nguong, gia tren may va chua "duoi gia"
// => MUA MOI (tai gia dong cua), Stop-loss RIENG duoi ho tro, TP1/2/3 rieng. Toi da 1 lan cho moi lenh goc. Lenh moi thoat khi
// cham Stop-loss rieng hoac khi lenh goc bi Ban (tin hieu). Vi the cu (15%) van giu gia mua cu.
// ============================================================================
BatMuaMoi = ParamToggle("MUA MOI sau TP3: bao mua moi khi hoi ve ho tro (chi xuat/hien thi)", "Tat|Bat", 1);
KieuHoTroMuaMoi = ParamList("Mua moi sau TP3 - ho tro", "Kijun|Can bang dai han (duoi)", 0);
DiemToiThieuMuaMoi = Param("Mua moi sau TP3 - diem toi thieu", 1.25, 0, 4, 0.05);
MuaMoiCaoToiDaPct = Param("Mua moi sau TP3 - gia toi da cao hon ho tro (%)", 4, 1, 15, 0.5);
HoTroMuaMoi = IIf(KieuHoTroMuaMoi == "Kijun", Kijun, CBBot);
MuaMoiTinHieu = BatMuaMoi AND (HoTroMuaMoi > 0)
    AND (L <= HoTroMuaMoi * (1 + DoChamHoTroPct/100)) AND (C > HoTroMuaMoi) AND (C <= HoTroMuaMoi * (1 + MuaMoiCaoToiDaPct/100))
    AND (C > O) AND (C > Ref(C,-1)) AND (TotalScore >= DiemToiThieuMuaMoi) AND (C > CloudTop)
    AND ChiTrong12NamGanNhat AND BreadthOk15 AND RSGateOk AND ThanhKhoanKL_Ok AND GiaToiThieuOk;
// SL do gia CHUYEN MUA (HoTroMuaMoi = muc ho tro vua duoc giu lai), khong do tu gia dong cua C. MuaMoiCaoToiDaPct
// da gioi han C khong cao hon HoTroMuaMoi qua X% nen SL khong bi keo qua xa gia vao thuc te.
SLMuaMoiTho = Min(HoTroMuaMoi - DemSLtheoATR * ATRVal, HoTroMuaMoi * (1 - SLToiThieuPct/100));
SLMuaMoiTho = Max(SLMuaMoiTho, HoTroMuaMoi * (1 - HardStopPct/100));
StopMuaMoiBar = IIf((HoTroMuaMoi > 0) AND (HoTroMuaMoi < C), SLMuaMoiTho,
                    C - Min(ATRVal * ATRMult, C * (HardStopPct/100)));

Sell = 0;
LyDoBan = 0;   // 0=chua ban, 1=TurnedPink(diem so), 2=Stop-loss, 3=SL bao ve lai
GiuTrongVongLap = 0;
GiaVaoTrongVongLap = 0;
ATRVaoTrongVongLap = 0;
StopVaoTrongVongLap = 0;
LoaiVaoLenh = 0;       // 1 = Buy thuong, 2 = MUA LAI
GiaVaoLuc = 0;         // gia vao thuc te tai phien vao lenh
StopVaoLuc = 0;        // Stop-loss thuc te tai phien vao lenh
TP1VaoVong = 0; TP2VaoVong = 0;
DaTP1Vong = 0; DaTP2Vong = 0;
DinhSauVaoVong = 0;
GiaBanBaoVe = 0;       // > 0 tai phien ban do cham SL bao ve
banGanNhatViTri = -999999;
banGanNhatCoLai = 0;
banGanNhatGia = 0;
soLanMuaLaiLienTiep = 0; // dem so lan MUA LAI lien tiep tu lan Mua thuong (LoaiVaoLenh=1) gan nhat - chan whipsaw quanh 1 muc ho tro.
ThamDoTrongVongLap = 0;      // 1 = dang giu o che do giai ngan 1 phan (chua bo sung)
ViTriVaoTrongVongLap = 0;
BoSungSuKien = 0;            // 1 = phien bo sung phan con lai
TP3VaoVong = 0; DaTP3Vong = 0;
Mua2Giu = 0;        // 1 = dang giu lenh MUA MOI (vong 2)
Mua2Gia = 0; Mua2Stop = 0; Mua2TP1 = 0; Mua2TP2 = 0; Mua2TP3 = 0;
Mua2Vi = 0;         // vi tri nen vao lenh mua moi
Mua2SuKien = 0;     // 1 = dung nen vao lenh mua moi
Mua2Cat = 0;        // 1 = cham Stop-loss rieng, 2 = dong cung lenh goc (Ban)
Mua2DaTung = 0;     // 1 = lenh goc hien tai da mua moi roi (toi da 1 lan)
for (i = 1; i < BarCount; i++)
{
    if (GiuTrongVongLap[i-1] == 1)
    {
        // DANG GIU - kiem tra dieu kien thoat TRUOC, bo qua Buy neu co
        // (dung y het ExRem: khong vao lenh lap khi dang giu).
        GiaVaoTrongVongLap[i] = GiaVaoTrongVongLap[i-1];
        ATRVaoTrongVongLap[i] = ATRVaoTrongVongLap[i-1];
        ViTriVaoTrongVongLap[i] = ViTriVaoTrongVongLap[i-1];
        StopVaoTrongVongLap[i] = StopVaoTrongVongLap[i-1];
        // MUA MOI SAU TP3: giu trang thai vong 2 qua tung nen khi lenh goc con giu.
        TP3VaoVong[i] = TP3VaoVong[i-1];
        Mua2DaTung[i] = Mua2DaTung[i-1];
        Mua2Giu[i] = Mua2Giu[i-1];
        Mua2Gia[i] = Mua2Gia[i-1];
        Mua2Stop[i] = Mua2Stop[i-1];
        Mua2TP1[i] = Mua2TP1[i-1];
        Mua2TP2[i] = Mua2TP2[i-1];
        Mua2TP3[i] = Mua2TP3[i-1];
        Mua2Vi[i] = Mua2Vi[i-1];
        // Stop-loss dong bang luc vao lenh (che do Cu = cong thuc ATR/6% nhu truoc).
        stopGiaThucTe_vonglap = StopVaoTrongVongLap[i];

        // Theo doi da cham TP1/TP2 va dinh tu luc vao - CHI dung cac phien TRUOC hom nay
        // (H[i-1]) va sau phien vao lenh, de khong nhin truoc tuong lai.
        TP1VaoVong[i] = TP1VaoVong[i-1];
        TP2VaoVong[i] = TP2VaoVong[i-1];
        hPrev = 0;
        if ((i - 1) > ViTriVaoTrongVongLap[i]) hPrev = H[i-1];
        DinhSauVaoVong[i] = Max(DinhSauVaoVong[i-1], hPrev);
        DaTP1Vong[i] = 0;
        DaTP2Vong[i] = 0;
        if (DaTP1Vong[i-1] == 1 OR hPrev >= TP1VaoVong[i]) DaTP1Vong[i] = 1;
        if (DaTP2Vong[i-1] == 1 OR hPrev >= TP2VaoVong[i]) DaTP2Vong[i] = 1;
        DaTP3Vong[i] = 0;
        if (DaTP3Vong[i-1] == 1 OR hPrev >= TP3VaoVong[i]) DaTP3Vong[i] = 1;
        stopBaoVe = 0;
        if (BVHoaVon AND DaTP2Vong[i] == 1) stopBaoVe = GiaVaoTrongVongLap[i];
        if (BVRong AND DaTP1Vong[i] == 1) stopBaoVe = DinhSauVaoVong[i] * (1 - BaoVeRongPct/100);
        chamBaoVe = 0;
        if (stopBaoVe > 0 AND L[i] <= stopBaoVe) chamBaoVe = 1;

        // STOP-LOSS CO DIEU KIEN - DA CHOT CHINH THUC: chi kich hoat khi
        // TotalScore dang AM tai dung phien do.
        // SLChamLaCat = Bat (mac dinh): cham Stop-loss la Ban ngay, khop ApplyStop cua Backtest. Tat = chi Ban khi diem am.
        DiemAmChoStop = TotalScore[i] < 0;
        ChamStopThat = (L[i] <= stopGiaThucTe_vonglap) AND (SLChamLaCat OR DiemAmChoStop);

        if (SellTinHieu[i] == 1 OR ChamStopThat OR chamBaoVe == 1)
        {
            Sell[i] = 1;
            // uu tien ghi Stop-loss thuong neu nhieu ly do cung dung; 3 = chi do SL bao ve lai
            LyDoBan[i] = IIf(ChamStopThat, 2, IIf(chamBaoVe == 1 AND SellTinHieu[i] == 0, 3, 1));
            GiuTrongVongLap[i] = 0;
            ThamDoTrongVongLap[i] = 0;
            // MUA MOI SAU TP3: lenh goc bi Ban thi lenh moi (neu dang giu) dong theo.
            if (Mua2Giu[i-1] == 1)
            {
                Mua2Giu[i] = 0;
                Mua2Cat[i] = 2;
            }
            // Gia ban de xet "lan ban nay co lo khong" (cho MUA LAI) va gia khop khi cham SL bao ve.
            giaBanLoop = C[i];
            if (chamBaoVe == 1 AND SellTinHieu[i] == 0 AND ChamStopThat == 0)
            {
                giaBanLoop = Min(O[i], stopBaoVe);
                GiaBanBaoVe[i] = giaBanLoop;
            }
            banGanNhatViTri = i;
            banGanNhatGia = giaBanLoop;
            banGanNhatCoLai = 0;
            if (giaBanLoop >= GiaVaoTrongVongLap[i]) banGanNhatCoLai = 1;
        }
        else
        {
            Sell[i] = 0;
            GiuTrongVongLap[i] = 1;

            // BO SUNG phan con lai - dieu kien giong het 7_Export_LenWeb.afl
            if (ThamDoTrongVongLap[i-1] == 1 AND (i - ViTriVaoTrongVongLap[i]) <= HanBoSungPhien
                AND RSVNI_OK[i] AND C[i] > GiaVaoTrongVongLap[i] AND TotalScore[i] >= EntryTh)
            {
                ThamDoTrongVongLap[i] = 0;
                BoSungSuKien[i] = 1;
            }
            else
            {
                ThamDoTrongVongLap[i] = ThamDoTrongVongLap[i-1];
            }

            // MUA MOI SAU TP3 (vong 2): (1) lenh moi dang giu -> kiem tra Stop-loss rieng; (2) chua co -> dieu kien vao.
            if (Mua2Giu[i-1] == 1)
            {
                if (L[i] <= Mua2Stop[i] AND (SLChamLaCat OR TotalScore[i] < 0))
                {
                    Mua2Giu[i] = 0;
                    Mua2Cat[i] = 1;
                }
            }
            else if (DaTP3Vong[i] == 1 AND Mua2DaTung[i] == 0 AND MuaMoiTinHieu[i])
            {
                Mua2Giu[i] = 1;
                Mua2DaTung[i] = 1;
                Mua2SuKien[i] = 1;
                Mua2Gia[i] = C[i];
                Mua2Stop[i] = StopMuaMoiBar[i];
                Mua2TP1[i] = TP1Vong[i];
                Mua2TP2[i] = TP2Vong[i];
                Mua2TP3[i] = TP3Vong[i];
                Mua2Vi[i] = i;
            }
        }
    }
    else if (Buy[i] OR (MuaLaiTinHieu[i] AND banGanNhatCoLai == 1 AND (i - banGanNhatViTri) <= HanMuaLaiPhien
                               AND C[i] <= banGanNhatGia * (1 + MuaLaiCaoToiDaPct/100)
                               AND soLanMuaLaiLienTiep < SoLanMuaLaiToiDa))
    {
        // CHUA GIU - Buy moi kich hoat vao lenh (hoac MUA LAI khi cong tac bat)
        if (Buy[i])
        {
            giaVaoLoop = GiaVaoBar[i];
            stopVaoLoop = StopVaoBar[i];
            LoaiVaoLenh[i] = 1;
            soLanMuaLaiLienTiep = 0;
        }
        else
        {
            // MUA LAI: vao tai gia dong cua, SL rieng duoi ho tro.
            giaVaoLoop = C[i];
            stopVaoLoop = StopMuaLaiBar[i];
            LoaiVaoLenh[i] = 2;
            soLanMuaLaiLienTiep = soLanMuaLaiLienTiep + 1;
        }
        GiuTrongVongLap[i] = 1;
        GiaVaoTrongVongLap[i] = giaVaoLoop;
        ATRVaoTrongVongLap[i] = ATRVal[i];
        StopVaoTrongVongLap[i] = stopVaoLoop;
        GiaVaoLuc[i] = giaVaoLoop;
        StopVaoLuc[i] = stopVaoLoop;
        TP1VaoVong[i] = TP1Vong[i];
        TP2VaoVong[i] = TP2Vong[i];
        TP3VaoVong[i] = TP3Vong[i];
        DinhSauVaoVong[i] = giaVaoLoop;
        ViTriVaoTrongVongLap[i] = i;
        if (RSVNI_OK[i]) ThamDoTrongVongLap[i] = 0;
        else ThamDoTrongVongLap[i] = 1;
    }
    else
    {
        GiuTrongVongLap[i] = 0;
    }
}
Buy = GiuTrongVongLap AND NOT Ref(GiuTrongVongLap,-1); // TAI TAO Buy dung: chi
    // ngay THAT SU bat dau giu lenh (khop voi vong lap, khong con lenh Mua
    // "thua" nao bi sot lai tu truoc khi qua ExRem sai)
Sell = ExRem(Sell, Buy);


// (Da BO tinh nang "Vung tham gia them" - gay nham lan/loi, khong dang tin cay)

SoViTheToiDa = Param("SO VI THE TOI DA (thay the Settings->Portfolio)", 8, 4, 30, 1);
SetOption("MaxOpenPositions", SoViTheToiDa);

SetPositionSize(TyTrongTheoNganh, spsPercentOfEquity);
SetOption("CommissionMode", 1);
SetOption("CommissionAmount", 0.25);

// ATRVal da chuyen len som hon (canh ATRMult/HardStopPct) de dung duoc trong vong lap Sell

// STOP-LOSS: "DONG BANG" ATR va gia VAO LENH tai dung thoi diem Mua (khong
// tinh lai theo ATR/gia moi ngay nhu truoc) + THEM CHAN AN TOAN theo % toi
// da. Ly do: ATR thuong NO RONG dung luc gia dang roi manh, neu dung ATR
// "song" (moi ngay) thi khoang dung se tu dong gian ra theo, khien lenh thua
// sau hon du dinh (day chinh la nguyen nhan gay lenh thua toi 15%+ da gap).
// He thong se dung khoang cach nao HEP HON trong 2 loai (ATR hoac % toi da).
ATRTaiVaoLenh    = ValueWhen(Buy, ATRVal, 1);
// GIA MUA THUC TE - nhap tay SAU KHI da khop lenh that (dua theo diem canh
// gio o khung 15 phut). AmiBroker KHONG THE tu dong biet ban da bam mua o
// gia nao trong ngay - day la lua chon thu cong cua ban, nen PHAI nhap tay.
// De = 0 (mac dinh) neu chua co lenh nao dang mo, hoac muon dung gia dong
// cua ngay tin hieu nhu binh thuong.
GiaMuaThucTe_Nhap = Param("Buoc 1: Go gia MUA THUC TE vao day", 0, 0, 999999, 0.01);
LuuGiaChoMaNay = ParamTrigger("Buoc 2: Bam de LUU gia cho DUNG MA NAY", "Luu gia");
// PHAI bam nut moi luu - KHONG tu dong luu chi vi o nhap con > 0, vi Param()
// khong tu reset ve 0 khi doi ma (van hien so cu tren hop), neu tu dong luu
// se bi "dinh" nham gia cua ma truoc sang ma vua doi toi.
if (LuuGiaChoMaNay AND LastValue(GiaMuaThucTe_Nhap) > 0)
{
    StaticVarSet("DaoGam_GiaMua_" + Name(), LastValue(GiaMuaThucTe_Nhap));
}
XoaGiaDaLuu = ParamTrigger("Hoac: Xoa gia da luu cho MA NAY", "Xoa gia");
if (XoaGiaDaLuu)
{
    StaticVarSet("DaoGam_GiaMua_" + Name(), 0);
}
GiaMuaThucTe = Nz(StaticVarGet("DaoGam_GiaMua_" + Name()));
GiaVaoLenh_MacDinh = ValueWhen(Buy, GiaVaoLuc, 1);
CoNhapGiaThucTe = GiaMuaThucTe > 0;
GiaVaoLenh       = IIf(CoNhapGiaThucTe, GiaMuaThucTe, GiaVaoLenh_MacDinh);

// TARGET CHO LENH HIEN TAI - sua lai CHINH XAC hon ban cu (ban cu la target
// "troi noi" theo cau truc gia gan nhat, KHONG lien quan gi toi viec co dang
// giu lenh hay khong - de gay hieu nham). Ban moi: dung DUNG 2 diem A (day)
// va B (dinh) cua con song DAN TOI diem Mua nay, dong bang gia tri tai DUNG
// thoi diem Mua (giong cach GiaVaoLenh da lam), roi chieu bien do song do tu
// GIA VAO LENH THAT - danh gia chinh xac "target cua lenh nay", khong phai
// target chung chung cua thi truong.
// (Da don gian hoa - khong con dung A-B-C/4-TP phuc tap nua. Muc chot loi
// tham khao gio dung THANG Khang cu gan nhat da co san, on dinh - xem duoi)
DiemDungATR      = ATRTaiVaoLenh * ATRMult;
DiemDungPhanTram = GiaVaoLenh * (HardStopPct/100);
DiemDungCu       = Min(DiemDungATR, DiemDungPhanTram);

// Che do MOI (va CHUA nhap tay gia mua thuc te): SL = SL cau truc da dong bang luc
// vao lenh. Che do Cu (hoac da nhap tay gia mua): cong thuc ATR/6% nhu truoc.
DungStopMoi = (CheDoMoc OR BatMuaLai) AND NOT CoNhapGiaThucTe;
StopMoiTaiMua = ValueWhen(Buy, StopVaoLuc, 1);
StopLossPrice = IIf(DungStopMoi, StopMoiTaiMua, GiaVaoLenh - DiemDungCu);
DiemDungThucTe = IIf(DungStopMoi, GiaVaoLenh - StopLossPrice, DiemDungCu);

ApplyStop(stopTypeLoss, stopModePoint, DiemDungThucTe, True);

// Che do MOI: Backtest khop lenh tai gia vao (moc chuyen mua) thay vi gia dong cua.
// BuyPrice phai nam trong [Low, High] cua phien - GiaVaoBar da dam bao dieu nay.
if (CheDoMoc)
{
    BuyPrice = IIf(Buy, GiaVaoLuc, C);
}
// Bao ve lai BAT: lenh ban do cham SL bao ve khop tai gia SL (hoac gia mo cua neu nhay von).
if (BVBat)
{
    SellPrice = IIf(Sell AND GiaBanBaoVe > 0, GiaBanBaoVe, C);
}

// Loai vao lenh cua lenh dang giu: 2 = MUA LAI (cong tac MUA LAI), 1 = Buy thuong.
LoaiVaoTaiMua = ValueWhen(Buy, LoaiVaoLenh, 1);
MuaLaiSuKien = Buy AND (LoaiVaoLenh == 2);
KhoangCachKijun = (C - Kijun) / C * 100;
KhoangCachCB = (C - (CBTop+CBBot)/2) / C * 100;

Dinh52T = HHV(H, 252); Day52T = LLV(L, 252);
DinhGanNhat = HHV(H, 60); DayGanNhat = LLV(L, 60);

KC1=IIf(Dinh52T>C,Dinh52T,1e10);
KC2=IIf(CBTop>C,CBTop,1e10);
KC3=IIf(CloudTop>C,CloudTop,1e10);
KC4=IIf(DinhGanNhat>C,DinhGanNhat,1e10);
KhangCuGanNhat_V2 = Min(Min(KC1,KC2),Min(KC3,KC4));
KhangCuCungNhat = IIf(Dinh52T>C, Dinh52T, KhangCuGanNhat_V2);
// Muc chot loi tham khao = KHANG CU GAN NHAT da co san (on dinh, luon co
// gia tri, khong phu thuoc tim pivot A-B-C phuc tap de loi nhu truoc).
// 3 MOC CHOT LOI - dung 3 nguon Khang cu da co san, ON DINH (khong tim
// pivot phuc tap): Dinh gan (60 phien, ngan han), Mua/duong can bang dai han (trung han),
// Dinh 52 tuan (dai han). Sap xep dam bao dung thu tu GAN -> XA du nguon
// nao lon hon (dung 1 trong nhung mo hinh sap xep 3-gia-tri co ban).
// FIX: dong bo voi 7_Export_LenWeb.afl - ma vua breakout (gia da vuot qua
// 1/ca 3 nguon) thi nguon do khong con la khang cu thuc su, se khien TP
// thap hon gia mua ("vua mua da bao chot loi"). Ep san toi thieu 5%/10%/15%
// tren gia hien tai, giu nguyen gia tri that neu no da o tren san do.
NguonGan   = Max(DinhGanNhat, GiaVaoBar * 1.05);
NguonGiua  = Max(Max(CBTop, CloudTop), GiaVaoBar * 1.10);
NguonXa    = Max(Dinh52T, GiaVaoBar * 1.15);
Tong3Nguon = NguonGan + NguonGiua + NguonXa;
ChotLoi_TP1 = Min(Min(NguonGan,NguonGiua),NguonXa);          // gan nhat
ChotLoi_TP3 = Max(Max(NguonGan,NguonGiua),NguonXa);          // xa nhat
ChotLoi_TP2 = Tong3Nguon - ChotLoi_TP1 - ChotLoi_TP3;          // con lai o giua

// DONG BANG 3 moc TP tai DUNG thoi diem Mua (giong cach da lam voi GiaVaoLenh
// va StopLossPrice) - tranh TP "chay theo" gia moi ngay, gay kho theo doi.
ChotLoi_TP1_TaiMua = ValueWhen(Buy, ChotLoi_TP1, 1);
ChotLoi_TP2_TaiMua = ValueWhen(Buy, ChotLoi_TP2, 1);
ChotLoi_TP3_TaiMua = ValueWhen(Buy, ChotLoi_TP3, 1);

TargetChoLenh = ChotLoi_TP1_TaiMua;   // giu ten cu de tuong thich cac cho khac

HT1=IIf(Day52T<C,Day52T,-1e10);
HT2=IIf(CBBot<C,CBBot,-1e10);
HT3=IIf(CloudBot<C,CloudBot,-1e10);
HT4=IIf(DayGanNhat<C,DayGanNhat,-1e10);
HoTroGanNhat_V2 = Max(Max(HT1,HT2),Max(HT3,HT4));
HoTroCungNhat = IIf(Day52T<C, Day52T, HoTroGanNhat_V2);

VNI_Close = Foreign("VNINDEX", "C");
Perf20_Ma = C/Ref(C,-20) - 1;
Perf20_VNI = VNI_Close/Ref(VNI_Close,-20) - 1;
RS_SoVoiVNI = (Perf20_Ma - Perf20_VNI) * 100;

// --- PHAN 2: DIEM RANK (0-100) - "setup nay co CHAT LUONG khong" - ghep tu
// CHINH cac tin hieu Dao Gam da co san (Sanyaku, FVG, ADX, Breadth, RS/VNI),
// KHONG dung du lieu/cong thuc tu nguon nao khac. ---
RankTuSanyaku   = (SoDiemSanyaku / 3) * 25;                          // toi da 25
RankTuFVG       = IIf(FVGDuLon, 20, IIf(InFVGZone, 10, 0));          // toi da 20
RankTuADX       = Min(20, ADXVal / 40 * 20);                          // toi da 20 (ADX=40 -> full diem)
RankTuBreadth   = Min(20, BreadthPctNganh / 60 * 20);                 // toi da 20 (Breadth>=60% -> full)
RankTuRS_VNI    = IIf(RS_SoVoiVNI > 0, 15, Max(0, 15 + RS_SoVoiVNI)); // toi da 15
DiemRank = RankTuSanyaku + RankTuFVG + RankTuADX + RankTuBreadth + RankTuRS_VNI;

// --- PHAN 3: DIEM CONFIDENCE (0-100) - "he thong CO CHAC voi huong nay
// khong" - do bang muc do DONG THUAN giua 3 thanh phan diem (Trend/Mom/DT)
// va so phien da giu vung xu huong. ---
CungDauTrend = Sign(TrendScore);
CungDauMom   = Sign(MomScore);
CungDauDT    = Sign(MFScore);
SoThanhPhanDongThuan = (CungDauTrend==CungDauMom) + (CungDauTrend==CungDauDT) + (CungDauMom==CungDauDT);
DiemDongThuan = SoThanhPhanDongThuan / 3 * 60;                        // toi da 60 (ca 3 cap deu dong thuan)
SoPhienGiuXuHuong = BarsSince(Cross(TotalScore, 0) OR Cross(0, TotalScore));
DiemBenVung = Min(40, SoPhienGiuXuHuong / 10 * 40);                   // toi da 40 (giu vung >=10 phien)
DiemConfidence = DiemDongThuan + DiemBenVung;

// --- PHAN 4: STOP THICH UNG (tuy chon) - Confidence cao -> Stop CHAT hon
// (khoa loi som), Confidence thap -> Stop giu nguyen nhu goc (an toan). CHI
// DUOC PHEP NOI RONG XUONG THAP HON he so goc, KHONG BAO GIO noi RONG hon
// (dam bao khong tang rui ro so voi ban goc da kiem chung). ---
DungStopThichUng = ParamToggle("Loc: Dung Stop thich ung theo Confidence (thu nghiem)", "Tat|Bat", 0);
HeSoATR_ThichUng = IIf(DungStopThichUng,
    ATRMult * (1.0 - (DiemConfidence/100) * 0.25),   // Confidence=100 -> giam toi da 25% he so ATR
    ATRMult);

// SUA LOI QUAN TRONG (da phat hien va sua lai an toan hon): DangGiuLenhVT
// dung Flip(Buy,Sell) don gian, ON DINH. Rieng "co the da cham Stop" chi la
// bien PHU de THAM KHAO, KHONG anh huong toi trang thai chinh.
DangGiuLenhVT = Flip(Buy, Sell);
// (Da bo ve Target len chart theo yeu cau - chi hien tren Card)

GiaVaoLenh_ChoStop = GiaVaoLenh;  // dung chung bien co gia nhap tay, tranh lech nhau
ATRVaoLenh_ChoStop = ValueWhen(Buy, ATRVal, 1);
// SL hien thi = StopLossPrice (che do Cu: ATR/6% nhu truoc; che do MOI: SL cau truc).
GiaStopThucTe_ChoHienThi = StopLossPrice;
StopThucTe_ChoHienThi = GiaVaoLenh_ChoStop - GiaStopThucTe_ChoHienThi;
CoTheDaChamStop = DangGiuLenhVT AND (C <= GiaStopThucTe_ChoHienThi);
// Dau hieu CHI HIEN THI (khong dung vong lap - dung Ref() don gian, AN TOAN
// hon cach cu da gay loi truoc do): danh dau dung ngay DAU TIEN gia cham
// Stop, de ve 1 lan duy nhat tren chart, khong lap lai moi ngay sau do.
ChamStopLanDau = CoTheDaChamStop AND NOT Ref(CoTheDaChamStop,-1);

GiaMuaVT = GiaVaoLenh;  // dung chung bien co gia nhap tay, tranh lech nhau
SoPhienNamGiuVT = BarsSince(Buy);
LaiLoVT = IIf(GiaMuaVT>0, (C/GiaMuaVT-1)*100, 0);

VuaMuaHomNay = Buy;
DangGiuTuTruoc = DangGiuLenhVT AND NOT VuaMuaHomNay AND NOT Sell;
BanHomNay = Sell;
DungNgoai = NOT DangGiuLenhVT AND NOT VuaMuaHomNay;

// CANH BAO BAN BOT - dong bo voi ban web: diem hom nay da roi duoi nguong
// Ban (-ExitTh) nhung van dang giu lenh va chua co tin hieu Ban that su hom
// nay. Khac voi dieu kien Stop-loss (o vong lap ben tren) - Stop-loss chi
// kich hoat Ban THAT khi diem AM (<0), con Ban bot chi la canh bao tham khao.
CanhBaoBanBot = DangGiuLenhVT AND ZoneSell AND NOT BanHomNay;

// ============================================================================
// VE VUNG LENH LEN CHART (CHI HIEN THI - khong anh huong Mua/Ban/backtest)
// Khi dang giu lenh, ve theo dung lenh do: GIA CHUYEN MUA (moc vua bi vuot o phien chuyen sang
// vung mua: may / duong can bang dai han - cung gia tri gui len web o cot "gia kich hoat"),
// VUNG MUA (tu gia chuyen mua den gia vao + %; chi N phien dau sau khi mua, ve bang 2 duong cham), GIA VAO, STOP-LOSS,
// TP1/TP2/TP3 (dong bang luc vao; duong cham thanh).
// CHE DO MOI Bat: gia vao chinh la gia chuyen mua ("cham diem mua la mua"). Che do Cu: gia vao = gia
// dong cua phien tin hieu, vung mua keo tu gia chuyen mua len den gia vao + %.
// ============================================================================
VeVungLenh = ParamToggle("Ve vung lenh len chart (gia chuyen mua, vung mua, SL, TP)", "Tat|Bat", 1);
VungMuaTranPct = Param("Vung mua: cao hon gia vao toi da (%)", 2, 0, 5, 0.5);
HanVeVungMua = Param("Vung mua/gia chuyen mua: chi ve N phien dau sau khi mua (0 = ca lenh)", 8, 0, 60, 1);
ToMauVungMua = ParamToggle("Vung mua: to mau nen (Tat = chi 2 duong cham cho nhe chart)", "Tat|Bat", 0);
GiaChuyenMuaTaiMua = ValueWhen(Buy, ValueWhen(VuaVaoVungMua, GiaKichHoatBar, 1), 1);
CoVungLenh = VeVungLenh AND DangGiuLenhVT AND GiaVaoLenh > 0;
TrongHanVungMua = IIf(HanVeVungMua == 0, 1, SoPhienNamGiuVT <= HanVeVungMua);
CoVungMua = CoVungLenh AND TrongHanVungMua;
CoGiaChuyenMua = CoVungMua AND GiaChuyenMuaTaiMua > 0 AND GiaChuyenMuaTaiMua <= GiaVaoLenh;
VungMuaDuoi = IIf(CoGiaChuyenMua, GiaChuyenMuaTaiMua, GiaVaoLenh);
VungMuaTren = GiaVaoLenh * (1 + VungMuaTranPct/100);
if (VeVungLenh)
{
    // Vung mua = 2 duong cham xanh la (mac dinh khong to mau nen de khong che nen gia); to mau nen chi khi bat ToMauVungMua.
    if (ToMauVungMua)
    {
        PlotOHLC(IIf(CoVungMua, VungMuaTren, Null), IIf(CoVungMua, VungMuaTren, Null),
                 IIf(CoVungMua, VungMuaDuoi, Null), IIf(CoVungMua, VungMuaDuoi, Null),
                 "Vung mua", ColorRGB(20,70,40), styleCloud|styleNoLabel);
    }
    Plot(IIf(CoVungMua, VungMuaTren, Null), "Vung mua (tren)", ColorRGB(0,170,80), styleLine|styleDots|styleNoLabel);
    Plot(IIf(CoVungMua, VungMuaDuoi, Null), "Vung mua (duoi)", ColorRGB(0,170,80), styleLine|styleDots|styleNoLabel);
    Plot(IIf(CoGiaChuyenMua, GiaChuyenMuaTaiMua, Null), "Gia chuyen mua", ColorRGB(0,230,120), styleLine);
    Plot(IIf(CoVungMua, GiaVaoLenh, Null), "Gia vao lenh", ColorRGB(170,230,170), styleLine|styleDashed|styleNoLabel);
    Plot(IIf(CoVungLenh AND StopLossPrice > 0, StopLossPrice, Null), "Stop-loss", ColorRGB(255,70,70), styleLine|styleDashed);
    Plot(IIf(CoVungLenh AND ChotLoi_TP1_TaiMua > 0, ChotLoi_TP1_TaiMua, Null), "TP1", ColorRGB(90,170,255), styleLine|styleDots|styleNoLabel);
    Plot(IIf(CoVungLenh AND ChotLoi_TP2_TaiMua > 0, ChotLoi_TP2_TaiMua, Null), "TP2", ColorRGB(60,220,220), styleLine|styleDots|styleNoLabel);
    Plot(IIf(CoVungLenh AND ChotLoi_TP3_TaiMua > 0, ChotLoi_TP3_TaiMua, Null), "TP3", ColorRGB(255,200,60), styleLine|styleDots|styleNoLabel);
}

// MUA MOI SAU TP3 (vong 2): mui ten xanh ngoc tai nen vao, duong gia vao / Stop-loss rieng khi dang giu lenh moi (chi hien thi).
if (BatMuaMoi)
{
    Plot(IIf(Mua2Giu, Mua2Gia, Null), "Mua moi - gia vao", ColorRGB(0,220,220), styleLine|styleDashed|styleNoLabel);
    Plot(IIf(Mua2Giu, Mua2Stop, Null), "Mua moi - Stop-loss", ColorRGB(255,110,110), styleLine|styleDots);
    PlotShapes(IIf(Mua2SuKien, shapeUpArrow, shapeNone), ColorRGB(0,220,220), 0, L, -60);
    PlotShapes(IIf(Mua2SuKien, shapeCircle, shapeNone), ColorRGB(0,220,220), 0, L, -45);
    PlotShapes(IIf(Mua2Cat == 1, shapeCircle, shapeNone), ColorRGB(255,110,110), 0, L, -65);
}

Plot(C, "Gia", IIf(C>=Ref(C,-1),ColorRGB(0,180,0),ColorRGB(220,50,50)), styleCandle);
Plot(Tenkan, "Tenkan 9", ColorRGB(0,140,255), styleLine|styleThick);
Plot(Kijun, "Kijun 17", ColorRGB(255,140,0), styleLine|styleThick);

CloudBullish = SenkouA > SenkouB;
CloudColor = IIf(CloudBullish, ColorRGB(0,120,0), ColorRGB(150,0,0));

// MAY VA 2 DUONG SENKOU KEO DAI VE TUONG LAI: ve mang GOC (SenkouA_Goc/SenkouB_Goc, chua dich) voi XShift = Shift
// nen may/duong duoc ve them Shift phien ben phai nen cuoi cung (phan "tuong lai"). Khoang trong ben phai do
// GraphXSpace tao ra. Cac bien CloudTop/CloudBot (da dich, dung cho logic Mua/Ban) KHONG doi - day chi la ve hinh.
VeMayTuongLai = ParamToggle("Ve may + Senkou keo dai Shift phien ve tuong lai", "Tat|Bat", 1);
KhoangTrongPhaiPct = Param("Khoang trong ben phai chart (%) - de hien may tuong lai", 18, 0, 40, 1);
GraphXSpace = KhoangTrongPhaiPct;
if (VeMayTuongLai)
{
    MayTopGoc = Max(SenkouA_Goc, SenkouB_Goc);
    MayBotGoc = Min(SenkouA_Goc, SenkouB_Goc);
    MauMayGoc = IIf(SenkouA_Goc > SenkouB_Goc, ColorRGB(0,120,0), ColorRGB(150,0,0));
    PlotOHLC(MayTopGoc, MayTopGoc, MayBotGoc, MayBotGoc, "May", MauMayGoc, styleCloud|styleNoLabel, Null, Null, Shift);
    Plot(SenkouA_Goc, "Senkou A", ColorRGB(0,190,0), styleLine|styleNoLabel, Null, Null, Shift);
    Plot(SenkouB_Goc, "Senkou B", ColorRGB(220,50,50), styleLine|styleNoLabel, Null, Null, Shift);
}
else
{
    PlotOHLC(CloudTop, CloudTop, CloudBot, CloudBot, "May", CloudColor, styleCloud|styleNoLabel);
}

// MAU SANG HON theo yeu cau ("ve ro hon") - mau nau cu qua toi, gan nhu
// khuat tren nen den cua chart. Doi sang tong tim sang, chua dung voi
// Tenkan (xanh duong)/Kijun (cam)/May (xanh la-do) da dung truoc do.
Plot(CBTop, "Can bang dai han tren (65)", ColorRGB(200,120,255), styleLine|styleThick|styleDashed);
Plot(CBBot, "Can bang dai han duoi (129)", ColorRGB(150,60,220), styleLine|styleThick|styleDashed);

// CHIKOU SPAN (duong tre) - gia dong cua HOM NAY, ve lui lai "Shift" phien
// ve truoc (dung y idiom chuan AFL: Ref(C, Shift) voi so duong = nhin ve
// TUONG LAI tai moi diem, tuong duong hien thi gia trị hom nay o vi tri
// Shift phien truoc). Truoc day CHUA ve dong nay len chart theo yeu cau.
// LUU Y KHI DOC CHART: diem vang tai 1 phien la Chikou cua phien CACH DO Shift PHIEN VE SAU (tuong lai),
// khong phai Chikou cua chinh phien do. Muon biet Chikou cua ngay X co thong thoang khong, phai nhin diem
// vang o vi tri Shift phien BEN TRAI ngay X (dong "Chikou thoang" o bang thong tin tinh san viec nay -
// CHI DE QUAN SAT, khong anh huong Mua/Ban).
// Chi ve nhung diem co du lieu that: Ref(C, +N) vuot qua nen cuoi se LAP lai gia dong cua cuoi cung, tao
// doan nam ngang gia tao o cuoi chart - bo doan do bang Null.
Chikou = IIf(BarIndex() + Shift <= LastValue(BarIndex()), Ref(C, Shift), Null);
Plot(Chikou, "Chikou Span", colorYellow, styleLine|styleThick);
// Cho bang thong tin: nen (dinh 5 phien) va dinh may TAI VI TRI Chikou cua tung phien duoc ve.
ChikouNenTaiViTri = Ref(HHV(H,5), -Shift);
ChikouMayTaiViTri = Ref(CloudTop, -Shift);

Plot(Dinh52T, "Dinh 52 tuan (CUNG)", colorGrey40, styleLine|styleDots|styleNoLabel|styleThick);
Plot(Day52T, "Day 52 tuan (CUNG)", colorGrey40, styleLine|styleDots|styleNoLabel|styleThick);
Plot(DinhGanNhat, "Dinh 3 thang", ColorRGB(218,165,32), styleLine|styleDashed|styleNoLabel);
Plot(DayGanNhat, "Day 3 thang", ColorRGB(218,165,32), styleLine|styleDashed|styleNoLabel);

// MUA DU (xanh la) vs MUA THAM DO/giai ngan 1 phan khi RS<=0 (vang) vs
// phien BO SUNG phan con lai (xanh ngoc).
MuaThamDo = Buy AND ThamDoTrongVongLap;
MuaDay = Buy AND NOT ThamDoTrongVongLap;
PlotShapes(IIf(MuaDay,shapeUpArrow,shapeNone), colorBrightGreen, 0, L, -35);
PlotShapes(IIf(MuaDay,shapeCircle,shapeNone), colorBrightGreen, 0, L, -20);
PlotShapes(IIf(MuaThamDo,shapeUpArrow,shapeNone), colorYellow, 0, L, -35);
PlotShapes(IIf(MuaThamDo,shapeCircle,shapeNone), colorYellow, 0, L, -20);
PlotShapes(IIf(BoSungSuKien,shapeUpTriangle,shapeNone), colorAqua, 0, L, -35);
PlotShapes(IIf(MuaLaiSuKien,shapeStar,shapeNone), colorAqua, 0, L, -55);   // MUA LAI (hoi ve ho tro)
PlotShapes(IIf(Sell,shapeDownArrow,shapeNone), ColorRGB(255,0,80), 0, H, 35);
PlotShapes(IIf(Sell,shapeCircle,shapeNone), ColorRGB(255,0,80), 0, H, 20);

// DAU HIEU RIENG cho ngay CHAM STOP-LOSS (mau cam, khac mau do cua Sell
// theo tin hieu diem so, de phan biet ro 2 loai "thoat lenh" khac nhau).
// Dung shapeCircle (da xac nhan hoat dong dung) thay vi shape la chua chac chan.
PlotShapes(IIf(ChamStopLanDau,shapeCircle,shapeNone), ColorRGB(255,140,0), 0, L, -50);

if (Status("action") == actionIndicator)
{
    GfxSetBkMode(1);
    GfxSelectFont("Arial", 9, 400);
    pxW = Status("pxwidth");
    pxH = Status("pxheight");

    DateTimeArr = DateTime();
    CursorDT = GetCursorXPosition(0);
    CursorDT = IIf(IsNull(CursorDT), LastValue(DateTimeArr), CursorDT);
    CountBeforeCursor = LastValue(Sum(DateTimeArr <= CursorDT, BarCount));
    CursorBar = Max(0, Min(BarCount - 1, CountBeforeCursor - 1));

    buy_c          = Buy[CursorBar];
    sell_c         = Sell[CursorBar];
    lydoban_c      = LyDoBan[CursorBar];
    diem_c         = TotalScore[CursorBar];
    trend_c        = TrendScore[CursorBar];
    mom_c          = MomScore[CursorBar];
    mf_c           = MFScore[CursorBar];
    adx_c          = ADXVal[CursorBar];
    breadthNganh_c = BreadthPctNganh[CursorBar];
    adxGateOk_c    = ADXGateOk[CursorBar];
    matthan_c      = MatThanWarning[CursorBar];
    banbot_c       = CanhBaoBanBot[CursorBar];
    thamdo_c       = ThamDoTrongVongLap[CursorBar];
    bosung_c       = BoSungSuKien[CursorBar];
    rsi_c          = RSIVal[CursorBar];
    mfi_c          = MFIVal[CursorBar];
    vol_c          = V[CursorBar];
    relvol_c       = RelVol[CursorBar];
    volgatengay1_c = VolumeGateNgayDau[CursorBar];
    vuavaovung_c   = VuaVaoVungMua[CursorBar];
    infvg_c        = InFVGZone[CursorBar];
    fvgDuLon_c     = FVGDuLon[CursorBar];
    doLonFVG_c     = DoLonSoATR_FVG[CursorBar];
    breakout_c     = BreakoutManh[CursorBar];
    rs_c           = RS_SoVoiVNI[CursorBar];
    stoploss_c     = StopLossPrice[CursorBar];
    dungATR_c      = DiemDungATR[CursorBar] <= DiemDungPhanTram[CursorBar];
    danggiu_c      = DangGiuLenhVT[CursorBar];
    coNhapGia_c    = CoNhapGiaThucTe[CursorBar];
    twistTang_c    = MayTuongLaiDoiChieuTang[CursorBar];
    twistGiam_c    = MayTuongLaiDoiChieuGiam[CursorBar];
    kijunPhang_c   = KijunDangPhang[CursorBar];
    senkouBPhang_c = SenkouBDangPhang[CursorBar];
    kijun_c        = Kijun[CursorBar];
    senkouB_c      = SenkouB[CursorBar];
    tp1_c = ChotLoi_TP1_TaiMua[CursorBar];
    tp2_c = ChotLoi_TP2_TaiMua[CursorBar];
    tp3_c = ChotLoi_TP3_TaiMua[CursorBar];
    sanyaku_c      = SoDiemSanyaku[CursorBar];
    chikouCoDuLieu_c = CursorBar >= Shift;
    chikouGia_c    = C[CursorBar];
    chikouNen_c    = ChikouNenTaiViTri[CursorBar];
    chikouMay_c    = ChikouMayTaiViTri[CursorBar];
    chikouThoang_c = chikouCoDuLieu_c AND (chikouGia_c > chikouNen_c) AND (chikouGia_c > chikouMay_c);
    rank_c         = DiemRank[CursorBar];
    confidence_c2  = DiemConfidence[CursorBar];
    rsiThongMinh_c = RSI_ThongMinh[CursorBar];
    retestMay_c    = DangRetestMay[CursorBar];
    ngayBienDoi_c  = DungNgayBienDoi[CursorBar];
    soPhienPivot_c = SoPhienTuPivot[CursorBar];
    chamstop_c     = CoTheDaChamStop[CursorBar];
    
    giamua_c       = GiaMuaVT[CursorBar];
    gcm_c          = GiaChuyenMuaTaiMua[CursorBar];
    m2giu_c        = Mua2Giu[CursorBar];
    m2gia_c        = Mua2Gia[CursorBar];
    m2stop_c       = Mua2Stop[CursorBar];
    m2tp1_c        = Mua2TP1[CursorBar];
    dtp3_c         = DaTP3Vong[CursorBar];
    sophien_c      = SoPhienNamGiuVT[CursorBar];
    laino_c        = LaiLoVT[CursorBar];
    kccung_c       = KhangCuCungNhat[CursorBar];
    kcgan_c        = KhangCuGanNhat_V2[CursorBar];
    htcung_c       = HoTroCungNhat[CursorBar];
    htgan_c        = HoTroGanNhat_V2[CursorBar];
    vuamua_c       = VuaMuaHomNay[CursorBar];
    danggiutruoc_c = DangGiuTuTruoc[CursorBar];
    dungngoai_c    = DungNgoai[CursorBar];
    date_c         = DateTimeArr[CursorBar];
    kijunkc_c      = KhoangCachKijun[CursorBar];

    MauChinh = IIf(vuamua_c, colorBrightGreen,
               IIf(danggiutruoc_c, colorYellow,
               IIf(sell_c, ColorRGB(255,80,80),
               ColorRGB(90,90,90))));
    KNTxt = WriteIf(vuamua_c,"MUA",WriteIf(danggiutruoc_c,"NAM GIU",WriteIf(sell_c,"BAN","TRUNG LAP")));

    tongW = Min(pxW - 20, 960);
    moiCardW = tongW/3 - 8;
    // CO GIAN CHIEU CAO CARD theo man hinh - tranh tran ra ngoai khi man
    // hinh thap (laptop nho). 360 la chieu cao "chuan" thiet ke goc; neu
    // man hinh cao hon 400px danh cho Card, giu nguyen 360; neu thap hon,
    // thu nho theo ty le (toi thieu 260 de van doc duoc).
    cH = Max(260, Min(360, pxH - 40));
    cY = 10;
    c1X = 10;
    c2X = c1X + moiCardW + 12;
    c3X = c2X + moiCardW + 12;

    GfxSelectPen(ColorRGB(200,197,188), 1); GfxSelectSolidBrush(ColorRGB(250,248,242));
    GfxRoundRect(c1X, cY, c1X+moiCardW, cY+cH, 10, 10);
    yy=cY+10;
    GfxSetTextColor(ColorRGB(50,48,45));
    GfxTextOut(Name()+" - "+WriteVal(date_c,formatDateTime), c1X+12, yy); yy=yy+20;

    GfxSelectPen(colorBlack); GfxSelectSolidBrush(MauChinh);
    GfxRoundRect(c1X+12, yy, c1X+100, yy+20, 5, 5);
    GfxSetTextColor(colorBlack);
    GfxTextOut(KNTxt, c1X+18, yy+2);
    GfxSetTextColor(ColorRGB(50,48,45));
    GfxTextOut("Diem:"+NumToStr(diem_c,1.2), c1X+108, yy+2);
    yy=yy+28;

    GfxSetTextColor(ColorRGB(110,108,100));
    GfxTextOut("Trend="+NumToStr(trend_c,1.1)+" Mom="+NumToStr(mom_c,1.1)+" DT="+NumToStr(mf_c,1.1), c1X+12, yy); yy=yy+16;
    GfxTextOut("ADX="+NumToStr(adx_c,1.1)+" RSI="+NumToStr(rsi_c,1.1)+" MFI="+NumToStr(mfi_c,1.1), c1X+12, yy); yy=yy+18;
    MauADXGate = IIf(adxGateOk_c, colorBrightGreen, ColorRGB(255,80,80));
    GfxSetTextColor(MauADXGate);
    GfxTextOut("ADX Gate: "+WriteIf(adxGateOk_c,"DAT (>="+NumToStr(ADXGateLv,1.0)+")","CHUA DAT"), c1X+12, yy); yy=yy+18;
    MauMatThan = IIf(matthan_c, ColorRGB(255,80,80), ColorRGB(120,120,120));
    GfxSetTextColor(MauMatThan);
    GfxTextOut("Mat Than: "+WriteIf(matthan_c,"CANH BAO! (chi tham khao)","Binh thuong"), c1X+12, yy); yy=yy+18;
    if (banbot_c)
    {
        GfxSetTextColor(ColorRGB(255,150,0));
        GfxTextOut("BAN BOT: diem da am, chua du dieu kien Ban han", c1X+12, yy); yy=yy+18;
    }
    if (thamdo_c)
    {
        GfxSetTextColor(ColorRGB(255,215,0));
        GfxTextOut("GIAI NGAN 1 PHAN (RS<=0) - cho bo sung trong "+NumToStr(HanBoSungPhien,1.0)+" phien", c1X+12, yy); yy=yy+18;
    }
    if (bosung_c)
    {
        GfxSetTextColor(colorAqua);
        GfxTextOut("BO SUNG: phien nay giai ngan not phan con lai", c1X+12, yy); yy=yy+18;
    }
    MauFVG = IIf(infvg_c, colorBrightGreen, ColorRGB(255,80,80));
    GfxSetTextColor(MauFVG);
    GhiChuFVG = WriteIf(CheDoFVG=="Luon TAT", " (che do: Luon TAT)",
                WriteIf(CheDoFVG=="Luon BAT", " (che do: Luon BAT)",
                WriteIf(breakout_c, " (Breakout manh - bo qua FVG)", " (che do: Thong minh)")));
    GfxTextOut("FVG Zone: "+WriteIf(infvg_c,WriteIf(fvgDuLon_c,"DANG MO (du lon)","Trong vung (QUA NHO)"),"KHONG CO/DA DONG")+GhiChuFVG, c1X+12, yy); yy=yy+18;
    if (infvg_c)
    {
        GfxSetTextColor(ColorRGB(110,108,100));
        GfxTextOut("  (Do lon FVG/ATR: "+NumToStr(doLonFVG_c,1.2)+"x)", c1X+12, yy); yy=yy+18;
        GfxSetTextColor(ColorRGB(50,48,45));
    }
    MauBreadthQ = IIf(breadthNganh_c>=NguongManh, colorBrightGreen, IIf(breadthNganh_c>=NguongYeu, colorYellow, ColorRGB(255,80,80)));
    GfxSetTextColor(MauBreadthQ);
    GfxTextOut("Breadth nganh: "+NumToStr(breadthNganh_c,1.0)+"%", c1X+12, yy); yy=yy+18;
    GfxSetTextColor(ColorRGB(50,48,45));
    GfxTextOut("Vol: "+NumToStr(vol_c,1.0)+" ("+NumToStr(relvol_c,1.2)+"x TB20)", c1X+12, yy); yy=yy+18;
    if (vuavaovung_c)
    {
        MauVolGate = IIf(volgatengay1_c, colorBrightGreen, ColorRGB(255,80,80));
        GfxSetTextColor(MauVolGate);
        GfxTextOut("Vol Gate Ngay1: "+WriteIf(volgatengay1_c,"DAT (mua ngay)","CHUA DAT (doi T2)"), c1X+12, yy); yy=yy+18;
    }
    GfxSetTextColor(IIf(rs_c>=0,colorBrightGreen,ColorRGB(255,80,80)));
    GfxTextOut("RS/VNI(20p): "+NumToStr(rs_c,1.2)+"%", c1X+12, yy); yy=yy+18;
    GfxSetTextColor(colorYellow);
    GfxTextOut("Stop-loss: "+NumToStr(stoploss_c,1.2)+WriteIf(dungATR_c," (theo ATR)"," (theo % toi da "+NumToStr(HardStopPct,1.1)+"%)"), c1X+12, yy);
    yy=yy+18;
    if (chamstop_c)
    {
        GfxSetTextColor(ColorRGB(255,0,0));
        GfxTextOut("*** GIA DA CHAM/VUOT STOP-LOSS! ***", c1X+12, yy); yy=yy+16;
        GfxTextOut("(Trong Backtest that: LENH NAY DA DONG.", c1X+12, yy); yy=yy+16;
        GfxTextOut("Trang thai/Lai-Lo tren Card co the KHONG", c1X+12, yy); yy=yy+16;
        GfxTextOut("con chinh xac - chi mang tinh tham khao)", c1X+12, yy);
    }

    GfxSelectPen(ColorRGB(200,197,188), 1); GfxSelectSolidBrush(ColorRGB(250,248,242));
    GfxRoundRect(c2X, cY, c2X+moiCardW, cY+cH, 10, 10);
    zy=cY+10;
    GfxSetTextColor(ColorRGB(50,48,45));
    GfxTextOut("HO TRO / KHANG CU", c2X+12, zy); zy=zy+22;
    GfxSetTextColor(ColorRGB(255,110,110));
    GfxTextOut("KC 52T (cung): "+WriteIf(kccung_c>=1e9,"Khong co",NumToStr(kccung_c,1.2)), c2X+12, zy); zy=zy+18;
    GfxSetTextColor(ColorRGB(110,108,100));
    GfxTextOut("KC gan: "+WriteIf(kcgan_c>=1e9,"Khong co",NumToStr(kcgan_c,1.2)), c2X+12, zy); zy=zy+22;
    GfxSetTextColor(colorBrightGreen);
    GfxTextOut("HT 52T (cung): "+WriteIf(htcung_c<=-1e9,"Khong co",NumToStr(htcung_c,1.2)), c2X+12, zy); zy=zy+18;
    GfxSetTextColor(ColorRGB(110,108,100));
    GfxTextOut("HT gan: "+WriteIf(htgan_c<=-1e9,"Khong co",NumToStr(htgan_c,1.2)), c2X+12, zy); zy=zy+22;
    GfxSetTextColor(ColorRGB(50,48,45));
    GfxTextOut("Cach Kijun: "+NumToStr(kijunkc_c,1.2)+"%", c2X+12, zy); zy=zy+22;

    // Kumo Twist tuong lai
    if (twistTang_c OR twistGiam_c)
    {
        GfxSetTextColor(IIf(twistTang_c, colorBrightGreen, ColorRGB(255,90,90)));
        GfxTextOut("May TL sap doi chieu "+WriteIf(twistTang_c,"TANG!","GIAM!"), c2X+12, zy); zy=zy+18;
    }

    // Flat Kijun / Flat SenkouB (nam cham gia)
    if (kijunPhang_c)
    {
        GfxSetTextColor(ColorRGB(140,170,255));
        GfxTextOut("Kijun PHANG ("+NumToStr(kijun_c,1.2)+") - nam cham", c2X+12, zy); zy=zy+18;
    }
    if (senkouBPhang_c)
    {
        GfxSetTextColor(ColorRGB(140,170,255));
        GfxTextOut("SenkouB PHANG ("+NumToStr(senkouB_c,1.2)+") - nam cham", c2X+12, zy); zy=zy+18;
    }

    // 3 MOC CHOT LOI - chi hien tung moc neu con cao hon gia (moc da vuot
    // qua thi khong hien nua, coi nhu "da chot xong phan do").
    if (danggiu_c AND (tp1_c > C[CursorBar] OR tp2_c > C[CursorBar] OR tp3_c > C[CursorBar]))
    {
        GfxSetTextColor(ColorRGB(200,140,0));
        GfxTextOut("3 muc chot loi tung phan:", c2X+12, zy); zy=zy+16;
        if (tp1_c > C[CursorBar])
            { GfxTextOut("  TP1 (gan, ngan han): "+NumToStr(tp1_c,1.2), c2X+12, zy); zy=zy+16; }
        if (tp2_c > C[CursorBar])
            { GfxTextOut("  TP2 (giua, trung han): "+NumToStr(tp2_c,1.2), c2X+12, zy); zy=zy+16; }
        if (tp3_c > C[CursorBar])
            { GfxTextOut("  TP3 (xa, 52 tuan): "+NumToStr(tp3_c,1.2), c2X+12, zy); zy=zy+16; }
    }

    // Sanyaku - diem chat luong 0-3 sao
    GfxSetTextColor(IIf(sanyaku_c>=2, colorBrightGreen, ColorRGB(110,108,100)));
    GfxTextOut("Sanyaku: "+NumToStr(sanyaku_c,1.0)+"/3 dieu kien dat", c2X+12, zy); zy=zy+22;

    // Chikou thong thoang tai phien dang tro (CHI QUAN SAT): Chikou (= dong cua phien nay) phai TREN nen
    // (dinh 5 phien) va TREN may tai vi tri no duoc ve (Shift phien truoc).
    if (chikouCoDuLieu_c)
    {
        GfxSetTextColor(IIf(chikouThoang_c, colorBrightGreen, ColorRGB(110,108,100)));
        GfxTextOut("Chikou thoang: "+WriteIf(chikouThoang_c,"CO","KHONG")+"  (Chikou "+NumToStr(chikouGia_c,1.2)+
                   " | nen "+NumToStr(chikouNen_c,1.2)+" | may "+NumToStr(chikouMay_c,1.2)+")", c2X+12, zy); zy=zy+22;
    }

    // RANK + CONFIDENCE (he thong goc, thu nghiem) - chi hien thi tham khao
    GfxSetTextColor(IIf(rank_c>=60, colorBrightGreen, ColorRGB(110,108,100)));
    GfxTextOut("Rank (chat luong setup): "+NumToStr(rank_c,1.0)+"/100", c2X+12, zy); zy=zy+18;
    GfxSetTextColor(IIf(confidence_c2>=60, colorBrightGreen, ColorRGB(110,108,100)));
    GfxTextOut("Confidence (do chac chan): "+NumToStr(confidence_c2,1.0)+"/100", c2X+12, zy); zy=zy+22;

    // Volume-confirmed Retest
    if (retestMay_c)
    {
        GfxSetTextColor(ColorRGB(255,180,0));
        GfxTextOut("Dang RETEST May (co Volume truoc do)", c2X+12, zy); zy=zy+18;
    }

    // Time Theory - ngay bien doi
    if (ngayBienDoi_c)
    {
        GfxSetTextColor(ColorRGB(255,100,255));
        GfxTextOut("NGAY BIEN DOI! ("+NumToStr(soPhienPivot_c,1.0)+" phien tu pivot)", c2X+12, zy);
        zy=zy+22;
    }

    // ----- CHU GIAI NGAN GON -----
    GfxSelectFont("Arial", 9, 400);
    GfxSetTextColor(ColorRGB(110,108,100));
    GfxTextOut("Chu giai: Mat Than=canh bao Ban gap |", c2X+12, zy); zy=zy+14;
    GfxTextOut("Mui ten tren/duoi May=canh bao dao chieu |", c2X+12, zy); zy=zy+14;
    GfxTextOut("So mau tren chart=gia Target lenh dang giu", c2X+12, zy);

    GfxSelectPen(colorWhite); GfxSelectSolidBrush(MauChinh);
    GfxRoundRect(c3X, cY, c3X+moiCardW, cY+cH, 10, 10);
    wy=cY+10;
    GfxSetTextColor(colorBlack);
    GfxSelectFont("Arial", 12, 700);
    GfxTextOut("KHUYEN NGHI: "+KNTxt, c3X+12, wy); wy=wy+26;
    GfxSelectFont("Arial", 9, 400);

    if (danggiu_c)
    {
        GfxTextOut("Gia mua: "+NumToStr(giamua_c,1.2), c3X+12, wy); wy=wy+18;
        if (coNhapGia_c)
        {
            GfxSetTextColor(ColorRGB(0,80,150));
            GfxTextOut("(gia THUC TE da nhap tay)", c3X+12, wy); wy=wy+16;
            GfxSetTextColor(colorBlack);
        }
        else
        {
            GfxSetTextColor(ColorRGB(80,80,80));
            GfxTextOut(WriteIf(CheDoMoc, "(vao tai gia chuyen mua - che do MOI)", "(gia dong cua ngay tin hieu - chua nhap tay)"), c3X+12, wy); wy=wy+16;
            GfxSetTextColor(colorBlack);
        }
        if (dtp3_c == 1)
        {
            GfxSetTextColor(ColorRGB(0,110,110));
            GfxTextOut("Da cham TP3 - tim diem mua moi", c3X+12, wy); wy=wy+16;
            if (m2giu_c == 1 AND m2gia_c > 0)
            {
                GfxTextOut("MUA MOI: "+NumToStr(m2gia_c,1.2)+"  SL "+NumToStr(m2stop_c,1.2)+"  TP1 "+NumToStr(m2tp1_c,1.2), c3X+12, wy); wy=wy+16;
            }
            GfxSetTextColor(colorBlack);
        }
        if (gcm_c > 0 AND gcm_c <= giamua_c)
        {
            GfxTextOut("Gia chuyen mua: "+NumToStr(gcm_c,1.2), c3X+12, wy); wy=wy+16;
            GfxTextOut("Vung mua: "+NumToStr(gcm_c,1.2)+" - "+NumToStr(giamua_c*(1+VungMuaTranPct/100),1.2), c3X+12, wy); wy=wy+16;
        }
        GfxTextOut("So phien nam giu: "+NumToStr(sophien_c,1.0), c3X+12, wy); wy=wy+18;
        GfxTextOut("Lai/Lo: "+NumToStr(laino_c,1.2)+"%", c3X+12, wy); wy=wy+18;
    }
    else
    {
        GfxTextOut("Khong co vi the dang mo", c3X+12, wy); wy=wy+18;
        if (sell_c)
        {
            GfxSetTextColor(ColorRGB(200,0,0));
            GfxTextOut("Ly do Ban: "+WriteIf(lydoban_c==2,"STOP-LOSS (cham gia dung lo)",
                       WriteIf(lydoban_c==3,"BAO VE LAI (cham SL sau chot loi)",
                       WriteIf(lydoban_c==1,"DIEM SO (3 phien xac nhan)",""))), c3X+12, wy); wy=wy+18;
            GfxSetTextColor(colorBlack);
        }
    }

    GfxSetTextColor(colorBlack);
    GfxTextOut("(T+2.5: lenh Ban can cach", c3X+12, wy); wy=wy+16;
    GfxTextOut("Mua toi thieu 2 phien)", c3X+12, wy);

    RequestTimedRefresh(0.2, True);
}

_SECTION_END();
