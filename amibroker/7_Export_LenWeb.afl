// ============================================================================
// DAO GAM SYSTEM v16 FULL - XUAT TIN HIEU TOAN BO THI TRUONG RA CSV
// (Ban dong bo v14: VN30 cap nhat + them VNMidcap/VNSmallcap + Breadth Gate
// bo sung 17 ma theo doi chieu GICS chinh thuc HOSE ky 1/2026)
//
// Phan LOI (tinh diem/tin hieu/Stop-loss/TP/Sanyaku/...) giu nguyen tu ban
// truoc, chi BO phan Plot()/PlotShapes()/Gfx panel (chi de hien thi tren
// chart, khong can khi chay Explore/quet toan bo thi truong) va THEM khoi
// tu dong ghi file CSV o cuoi.
//
// CACH DUNG:
//   1. Sua duong dan o bien DuongDanFileXuat cho khop may ban.
//   2. Trong AmiBroker: Analysis -> New Analysis -> dan formula nay vao.
//   3. Settings: Apply to = All Symbols, Periodicity = Daily.
//   4. Bam "Explore" -> file CSV se tu dong duoc ghi/ghi de tai duong dan da
//      chon, KHONG can bam "Export" tay nua.
// ============================================================================
_SECTION_BEGIN("Dao Gam System v16 FULL - Export Len Web");

TenkanLen   = Param("Tenkan", 9, 2, 50, 1);
KijunLen    = Param("Kijun", 17, 2, 100, 1);
SenkouBLen  = Param("Senkou B", 33, 2, 150, 1);
Shift       = Param("Dich chuyen may", 26, 1, 60, 1);
GG1Len      = Param("Giao Gam 1", 65, 10, 200, 1);
GG2Len      = Param("Giao Gam 2", 129, 10, 300, 1);
EntryTh     = Param("Nguong diem VAO lenh (Mua)", 1.25, 0.5, 3, 0.05);
ExitTh      = Param("Nguong diem RA lenh (Ban, so duong)", 1.5, 0.5, 3, 0.05);
PersistBars = Param("So phien giu tren nguong", 1, 1, 5, 1);
UseADXGate  = ParamToggle("Bat buoc ADX>=18", "Tat|Bat", 1);
ADXGateLv   = Param("Nguong ADX (neu bat)", 18, 10, 40, 1);
CheDoFVG    = ParamList("Che do dieu kien FVG",
              "Thong minh (bo qua khi breakout manh)|Luon BAT|Luon TAT", 0);
NguongDiemBreakout = Param("Thong minh: diem cao hon nguong bao nhieu la Breakout", 1.0, 0, 3, 0.1);
ATRMult     = Param("He so ATR cho Stop-loss", 2.2, 1, 4, 0.1);
HardStopPct = Param("Stop-loss toi da theo % (chan an toan)", 6, 3, 20, 0.5);
ATRVal = ATR(14);
FVGLookback = Param("FVG het han sau (phien)", 15, 5, 30, 1);

// RS/VNI - DA CHOT CHINH THUC, dong bo voi he thong v14.
VNI_Close = Foreign("VNINDEX", "C");
RS_SoVoiVNI = (C/Ref(C,-20) - 1 - (VNI_Close/Ref(VNI_Close,-20) - 1)) * 100;
RSVNI_OK = RS_SoVoiVNI > 0;

VolMinPctTB20     = Param("Ngay1-Vol: toi thieu so voi TB20 (%)", 50, 0, 300, 5);
VolMinPctHomTruoc = Param("Ngay1-Vol: toi thieu so voi hom truoc (%)", 30, 0, 300, 5);
PocketPivotNhinLai= Param("Ngay1-Vol: Pocket Pivot nhin lai (phien)", 10, 5, 30, 1);

Tenkan  = (HHV(H,TenkanLen) + LLV(L,TenkanLen)) / 2;
Kijun   = (HHV(H,KijunLen) + LLV(L,KijunLen)) / 2;
SenkouA = Ref((Tenkan+Kijun)/2, -Shift);
SenkouB = Ref((HHV(H,SenkouBLen)+LLV(L,SenkouBLen))/2, -Shift);
CloudTop = Max(SenkouA, SenkouB);
CloudBot = Min(SenkouA, SenkouB);

// KUMO TWIST TUONG LAI - CHI hien thi tham khao.
SenkouA_Goc = (Tenkan+Kijun)/2;
SenkouB_Goc = (HHV(H,SenkouBLen)+LLV(L,SenkouBLen))/2;
MayTuongLaiDoiChieuTang = SenkouA_Goc > SenkouB_Goc AND Ref(SenkouA_Goc,-1) <= Ref(SenkouB_Goc,-1);
MayTuongLaiDoiChieuGiam = SenkouA_Goc < SenkouB_Goc AND Ref(SenkouA_Goc,-1) >= Ref(SenkouB_Goc,-1);

// FLAT KIJUN / FLAT SENKOU B - CHI hien thi tham khao.
SoPhienKiemTraFlat = Param("So phien kiem tra duong phang (Kijun/SenkouB)", 5, 3, 15, 1);
KijunDangPhang = (HHV(Kijun, SoPhienKiemTraFlat) - LLV(Kijun, SoPhienKiemTraFlat)) == 0;
SenkouBDangPhang = (HHV(SenkouB, SoPhienKiemTraFlat) - LLV(SenkouB, SoPhienKiemTraFlat)) == 0;

// TARGET GIA (Price Theory V/N/E) - tim pivot A(day)/B(dinh)/C(day dieu chinh).
CuaSoPivot = 5;
DiemA = 0; DiemB = 0; DiemC = 0;
ViTriA = 0; ViTriB = 0; ViTriC = 0;
for (i = CuaSoPivot; i < BarCount - CuaSoPivot; i++)
{
    laDayPivot = 1;
    for (k = 1; k <= CuaSoPivot; k++)
    {
        if (L[i] > L[i-k] OR L[i] > L[i+k]) { laDayPivot = 0; break; }
    }
    if (laDayPivot)
    {
        ViTriA[i] = i;
        DiemA[i] = L[i];
    }
    else
    {
        ViTriA[i] = ViTriA[i-1];
        DiemA[i] = DiemA[i-1];
    }

    laDinhPivot = 1;
    for (k = 1; k <= CuaSoPivot; k++)
    {
        if (H[i] < H[i-k] OR H[i] < H[i+k]) { laDinhPivot = 0; break; }
    }
    if (laDinhPivot AND ViTriA[i] > 0 AND i > ViTriA[i])
    {
        ViTriB[i] = i;
        DiemB[i] = H[i];
        ViTriC[i] = 0;
        DiemC[i] = 0;
    }
    else
    {
        ViTriB[i] = ViTriB[i-1];
        DiemB[i] = DiemB[i-1];
        if (laDayPivot AND ViTriB[i-1] > 0 AND i > ViTriB[i-1])
        {
            ViTriC[i] = i;
            DiemC[i] = L[i];
        }
        else
        {
            ViTriC[i] = ViTriC[i-1];
            DiemC[i] = DiemC[i-1];
        }
    }
}

// SANYAKU KOUTEN - "diem chat luong" tong hop 3 dieu kien kinh dien Ichimoku
// (KHONG dung de vao lenh - den tre - CHI danh gia do "chac chan" cua tin
// hieu da co). Dem so dieu kien dat trong 3.
DK1_TenkanCatKijun = Tenkan > Kijun AND Ref(Tenkan,-1) <= Ref(Kijun,-1);
DuDuLieuChoChikou_Sanyaku = BarIndex() >= Shift;
DK2_ChikouThoat = IIf(DuDuLieuChoChikou_Sanyaku, C > Ref(HHV(H,5), -Shift), False);
DK3_PhaLenMay = C > CloudTop AND Ref(C,-1) <= Ref(CloudTop,-1);
SoDiemSanyaku = DK1_TenkanCatKijun + DK2_ChikouThoat + DK3_PhaLenMay;

// TIME THEORY / KIHON SUCHI - CHI hien thi tham khao.
ViTriPivotGanNhat = Max(ViTriA, ViTriB);
SoPhienTuPivot = BarIndex() - ViTriPivotGanNhat;
DungNgayBienDoi = (Abs(SoPhienTuPivot-9)<=1) OR (Abs(SoPhienTuPivot-17)<=1) OR
    (Abs(SoPhienTuPivot-26)<=1) OR (Abs(SoPhienTuPivot-33)<=1) OR
    (Abs(SoPhienTuPivot-42)<=1) OR (Abs(SoPhienTuPivot-51)<=1) OR
    (Abs(SoPhienTuPivot-65)<=1) OR (Abs(SoPhienTuPivot-76)<=1) OR
    (Abs(SoPhienTuPivot-129)<=1) OR (Abs(SoPhienTuPivot-172)<=1) OR
    (Abs(SoPhienTuPivot-200)<=1) OR (Abs(SoPhienTuPivot-257)<=1);

GiaoGam1 = (HHV(H,GG1Len)+LLV(L,GG1Len))/2;
GiaoGam2 = (HHV(H,GG2Len)+LLV(L,GG2Len))/2;
GGTop = Max(GiaoGam1, GiaoGam2);
GGBot = Min(GiaoGam1, GiaoGam2);

ADXVal = ADX(14);
DIPlus = PDI(14);
DIMinus = MDI(14);
RSIVal = RSI(14);
MFIVal = MFI(14);
AvgVol20 = Ref(MA(V,20),-1);
RelVol = IIf(AvgVol20>0, V/AvgVol20, 1);

// VOLUME-CONFIRMED KUMO BREAKOUT + RETEST - CHI hien thi tham khao.
NguongVolBreakout = Param("Nguong RelVol de coi la Breakout co Volume", 1.3, 1, 3, 0.1);
PhaLenMayCoVolume = (C > CloudTop) AND (Ref(C,-1) <= Ref(CloudTop,-1)) AND (RelVol >= NguongVolBreakout);
SoNenTuBreakout = BarsSince(PhaLenMayCoVolume);
DangRetestMay = (SoNenTuBreakout > 0) AND (SoNenTuBreakout <= 10) AND
                (C > CloudTop) AND (L <= CloudTop*1.02);

// --- 3 dieu kien Volume cho phien MUA DAU TIEN (khi vua chuyen xanh) ---
VolDatTB20        = RelVol >= (1 + VolMinPctTB20/100);
VolDatHomTruoc     = IIf(Ref(V,-1)>0, V >= Ref(V,-1)*(1+VolMinPctHomTruoc/100), False);
MaxVolNgayGiam10  = Ref(HHV(IIf(C<Ref(C,-1), V, 0), PocketPivotNhinLai), -1);
VolDatPocketPivot = V > MaxVolNgayGiam10;
VolumeGateNgayDau = VolDatTB20 AND VolDatHomTruoc AND VolDatPocketPivot;

TrendScore = IIf(C>CloudTop,1, IIf(C<CloudBot,-1,0))
           + IIf(C>GGTop,1, IIf(C<GGBot,-1,0))
           + IIf(Tenkan>Kijun,0.5,-0.5)
           + IIf(ADXVal>25, IIf(DIPlus>DIMinus,0.5,-0.5), 0);
MomScore = IIf(RSIVal>70,-0.5, IIf(RSIVal<30,0.5, IIf(RSIVal>50,0.5,-0.5)));
MFScore = IIf(MFIVal>80,-0.5, IIf(MFIVal<20,0.5, IIf(MFIVal>50,0.5,-0.5)))
        + IIf(RelVol>1.5,0.5, IIf(RelVol<0.5,-0.3,0));
TotalScore = TrendScore*1.5 + MFScore*1.2 + MomScore*1.0;

InFVGZone = 0;
for (i = 2; i < BarCount; i++)
{
    if (H[i-2] < L[i])
    {
        gapBot = H[i-2]; gapTop = L[i];
        expireAt = Min(i + FVGLookback, BarCount-1);
        for (j = i; j <= expireAt; j++)
        {
            if (L[j] < gapBot) break;
            if ((L[j] <= gapTop AND L[j] >= gapBot) OR (C[j] <= gapTop AND C[j] >= gapBot))
                InFVGZone[j] = 1;
        }
    }
}

// FVG - UU TIEN VUNG LON SO VOI ATR (H3, DA CHOT CHINH THUC).
DoLonSoATR_FVG = 0;
for (i = 2; i < BarCount; i++)
{
    if (H[i-2] < L[i])
    {
        gapBot = H[i-2]; gapTop = L[i];
        gapSize = gapTop - gapBot;
        atrLucHinhThanh = ATRVal[i];
        tySoLonATR = IIf(atrLucHinhThanh>0, gapSize/atrLucHinhThanh, 0);
        expireAt = Min(i + FVGLookback, BarCount-1);
        for (j = i; j <= expireAt; j++)
        {
            if (L[j] < gapBot) break;
            if ((L[j] <= gapTop AND L[j] >= gapBot) OR (C[j] <= gapTop AND C[j] >= gapBot))
                if (tySoLonATR > DoLonSoATR_FVG[j]) DoLonSoATR_FVG[j] = tySoLonATR;
        }
    }
}
NguongDiemFVGMem = Param("FVG: Nguong ty le lon/ATR toi thieu (da chot ~0.6)", 0.6, 0.1, 2, 0.05);
FVGDuLon = DoLonSoATR_FVG >= NguongDiemFVGMem;

MatThanWarning = 0;
for (i = 5; i < BarCount-5; i++)
{
    isPivotHigh = 1;
    for (k = 1; k <= 5; k++)
        if (H[i] < H[i-k] OR H[i] < H[i+k]) { isPivotHigh = 0; break; }
    if (isPivotHigh AND H[i] > CloudTop[i])
    {
        enteredAt = -1;
        limitJ = Min(i+26, BarCount-1);
        for (j = i+1; j <= limitJ; j++)
            if (L[j] <= CloudTop[i] AND H[j] >= CloudBot[i]) { enteredAt = j; break; }
        if (enteredAt > 0 AND (BarCount-1-enteredAt) <= 5)
        {
            brokeAbove = 0;
            limitK = Min(enteredAt+5, BarCount-1);
            for (k = enteredAt; k <= limitK; k++)
                if (C[k] > Tenkan[k]) { brokeAbove = 1; break; }
            if (!brokeAbove)
                for (k = enteredAt; k <= limitK; k++)
                    MatThanWarning[k] = 1;
        }
    }
}

Above = TotalScore >= EntryTh;
ConsecutiveAbove = Sum(Above, PersistBars) == PersistBars;
VuaVaoVungMua = Above AND NOT Ref(Above,-1);
BoQuaADXNeuDiemManh = Param("Bo qua ADX Gate neu |TotalScore| >= muc nay", 2.0, 1.5, 4, 0.1);
ADXGateOk = IIf(UseADXGate, (ADXVal >= ADXGateLv) OR (Abs(TotalScore) >= BoQuaADXNeuDiemManh), 1);

BreakoutManh = (TotalScore >= EntryTh + NguongDiemBreakout);

InFVGZone_H3 = InFVGZone AND FVGDuLon;
InFVGZoneOk = IIf(CheDoFVG=="Luon TAT", 1,
              IIf(CheDoFVG=="Luon BAT", InFVGZone_H3,
              IIf(BreakoutManh AND VolumeGateNgayDau, 1, InFVGZone_H3)));

TurnedGreen = 0;
DaMuaDotNay = 0;
for (i = 1; i < BarCount; i++)
{
    if (!ConsecutiveAbove[i])
    {
        DaMuaDotNay[i] = 0;
    }
    else
    {
        DuDieuKienVolumeNgayDau = !VuaVaoVungMua[i] OR VolumeGateNgayDau[i];
        if (ConsecutiveAbove[i] AND InFVGZoneOk[i] AND ADXGateOk[i] AND DuDieuKienVolumeNgayDau AND !DaMuaDotNay[i-1])
        {
            TurnedGreen[i] = 1;
            DaMuaDotNay[i] = 1;
        }
        else
        {
            DaMuaDotNay[i] = DaMuaDotNay[i-1];
        }
    }
}

SoPhienBanXacNhan = Param("So phien Ban can xac nhan lien tuc", 3, 1, 5, 1);
ZoneSell = TotalScore <= -ExitTh;
ZoneSellXacNhan = Sum(ZoneSell, SoPhienBanXacNhan) == SoPhienBanXacNhan;
TurnedPink = ZoneSellXacNhan AND NOT Ref(ZoneSellXacNhan,-1);

// VN30 - CAP NHAT dung theo ky co cau thang 7/2026 (nguon: HOSE, xac nhan
// qua cong ty chung khoan AAS 22/07/2026). Dong bo voi he thong v14.
VN30List = "ACB,BID,BSR,BVH,CTG,FPT,GAS,GVR,HDB,HPG,"+
    "MBB,MSN,MWG,PLX,POW,SAB,SSB,SSI,STB,TCB,"+
    "TPB,VCB,VHM,VIB,VIC,VJC,VNM,VPB,VPL,VRE";
InVN30 = StrFind( "," + VN30List + ",", "," + Name() + "," ) > 0;

// VNMIDCAP - 71 ma. LUU Y: ke thua tu du lieu HOSE ky 1/2026, da dieu chinh
// 3 ma chuyen nhom voi VN30 (BSR/BVH/POW ra, DGC/LPB/SHB vao). Bo sung MSR
// (Masan High-Tech Materials) - bi thieu sot trong danh sach goc, khien ma
// nay bi loai het khoi quet (khong thuoc VN30/Midcap/Smallcap nao).
// Bo sung them 16 ma khi doi chieu voi bang dashboard nganh nguoi dung gui
// (bao gom ca HNX/UPCOM theo yeu cau mo rong het cac san - xem DS_SanHNX/
// DS_SanUPCOM ben duoi de biet ma nao khac HOSE): TMS,MBS,SHS,BVS,PVS,OIL,
// VGI,FOX,ACV,VGT,NTP,QNS,LTG,HNG,MCH,PVI.
VNMidCapList = "ANV,BCM,BMP,BSI,BWE,CII,CMG,CTD,CTR,CTS,"+
    "DBC,DCM,DGW,DIG,DPM,DSE,DXG,DXS,EIB,EVF,"+
    "FRT,FTS,GEE,GEX,GMD,HAG,HCM,HDC,HDG,HHV,"+
    "HSG,HT1,IMP,KBC,KDC,KDH,KOS,MSB,NAB,NKG,"+
    "NLG,NT2,NVL,OCB,PAN,PC1,PDR,PHR,PNJ,PVD,"+
    "PVT,REE,SBT,SCS,SIP,SJS,SZC,TCH,VCG,VCI,"+
    "VGC,VHC,VIX,VND,VPI,VSC,VTP,DGC,LPB,SHB,MSR,"+
    "TMS,MBS,SHS,BVS,PVS,OIL,VGI,FOX,ACV,VGT,"+
    "NTP,QNS,LTG,HNG,MCH,PVI,TCX,VCK";
InVNMidCap = StrFind( "," + VNMidCapList + ",", "," + Name() + "," ) > 0;

// VNSMALLCAP - 209 ma. Tinh bang VNAllshare (302 ma, cong bo chinh thuc
// HOSE ky 1/2026 qua Vietstock) TRU DI VN100. Bo sung 7 ma bi thieu sot
// (da co san trong danh sach 15 nganh nhung lai khong nam trong ca 3 danh
// sach von hoa nen bi loai het khoi quet - phat hien khi ra soat toan bo):
// DHG, TRA, VCF, HVN, SVC, CAV, DQC.
// Bo sung tiep 11 ma cung loi "co trong danh sach nganh nhung khong o von
// hoa nao" (PGI,NTC,VSH,SPM,TVT,STG,VNA,C47,KLB,BVB,VAB) + ~59 ma HOAN TOAN
// MOI khi doi chieu voi bang dashboard nganh nguoi dung gui, theo yeu cau
// mo rong ra CA HNX/UPCOM (khong con gioi han rieng HOSE nhu truoc) - xem
// DS_SanHNX/DS_SanUPCOM ben duoi de biet ma nao khac san HOSE.
VNSmallCapList = "AAA,AAM,ABS,ABT,ACC,ACL,ADG,ADP,ADS,AGG,"+
    "AGR,APG,APH,ASM,ASP,AST,BAF,BCE,BFC,BIC,"+
    "BKG,BMC,BMI,BRC,BTP,C32,CCC,CCL,CDC,CHP,"+
    "CIG,CKG,CLL,CMX,CNG,CRC,CRE,CSM,CSV,CTF,"+
    "CTI,D2D,DAH,DBD,DC4,DCL,DHA,DHC,DHM,DLG,"+
    "DMC,DPG,DPR,DRC,DRL,DSC,DSN,DTA,DVP,DXV,"+
    "ELC,EVE,EVG,FCM,FCN,FIR,FIT,FMC,GDT,GEG,"+
    "GIL,GSP,HAH,HAP,HAR,HAX,HCD,HHP,HHS,HID,"+
    "HII,HMC,HPX,HQC,HSL,HTG,HTI,HTN,HTV,HUB,"+
    "HVH,ICT,IDI,IJC,ILB,ITC,ITD,JVC,KHG,KHP,"+
    "KMR,KSB,LAF,LBM,LCG,LGL,LHG,LIX,LSS,MCM,"+
    "MCP,MHC,MIG,MSH,NAF,NAV,NBB,NCT,NHA,NHH,"+
    "NNC,NO1,NSC,NTL,OGC,ORS,PAC,PET,PGC,PHC,"+
    "PIT,PLP,PPC,PTB,PTC,PTL,PVP,QCG,RAL,RYG,"+
    "SAM,SAV,SBG,SCR,SFC,SFI,SGN,SGR,SGT,SHA,"+
    "SHI,SJD,SKG,SMB,ST8,STK,SVD,SVT,SZL,TCI,"+
    "TCL,TCM,TCO,TCT,TDC,TDG,TDH,TDP,TEG,THG,"+
    "TIP,TLD,TLG,TLH,TMT,TN1,TNH,TNI,TNT,TRC,"+
    "TSC,TTA,TTF,TV2,TVB,TVS,UIC,VCA,VDS,VFG,"+
    "VIP,VNL,VOS,VPG,VPH,VPS,VRC,VSI,VTB,VTO,"+
    "YBM,YEG,DHG,TRA,VCF,HVN,SVC,CAV,DQC,"+
    "PGI,NTC,VSH,SPM,TVT,STG,VNA,C47,KLB,BVB,"+
    "VAB,CEO,L18,HLD,EVS,APS,TVC,PSI,BMS,SBS,"+
    "WSS,AAS,NVB,ABB,BAB,TVN,SMC,VGS,POM,GDA,"+
    "PVC,PLC,PVB,PSD,ABI,VNR,PRE,PTI,IDC,IDV,"+
    "FOC,TV1,QTP,HND,PVG,RIC,SAS,LDP,DHT,TNG,"+
    "DXP,PHP,NET,LAS,HBC,DRI,KSV,HGM,SLS,TAR,HUT";
InVNSmallCap = StrFind( "," + VNSmallCapList + ",", "," + Name() + "," ) > 0;

SoNamGanNhat = Param("So nam gan nhat de test (0 = khong gioi han)", 12, 0, 99, 1);
SoPhienUocTinh = IIf(SoNamGanNhat<=0, BarCount, SoNamGanNhat * 250);
ChiTrong12NamGanNhat = IIf(SoNamGanNhat<=0, True,
    BarIndex() >= (LastValue(BarIndex()) - SoPhienUocTinh));

BatBreadthGate = ParamToggle("Bat Breadth Gate 15 Nganh", "Tat|Bat", 1);
NguongManh = Param("Nguong Breadth NGANH MANH (100% ty trong)", 60, 30, 90, 5);
NguongYeu = Param("Nguong Breadth NGANH YEU (duoi muc nay)", 30, 10, 60, 5);

function TinhBreadth(DanhSachMa, SoLuong)
{
    dem = 0;
    for (i = 0; i < SoLuong; i++)
    {
        tk = StrExtract(DanhSachMa, i);
        px = LastValue(Foreign(tk, "C"));
        maVal = LastValue(MA(Foreign(tk,"C"), 50));
        if (px > maVal) dem = dem + 1;
    }
    return dem / SoLuong * 100;
}

// 15 NGANH - DA BO SUNG 17 MA theo doi chieu GICS chinh thuc HOSE ky 1/2026
// (dong bo voi he thong v14: chi ap dung cac truong hop do tin cay Cao+TB).
DS_NganHang = "ACB,BID,BVB,CTG,EIB,HDB,KLB,LPB,MBB,MSB,NAB,OCB,SHB,SSB,STB,TCB,TPB,VAB,VBB,VCB,VIB,VPB,NVB,ABB,BAB";
DS_BDS = "AGG,ASM,CCL,CII,CKG,CRE,DIG,DXG,DXS,EVG,FDC,FIR,HAR,HDC,HDG,HPX,HQC,HTN,ITC,KDH,KHG,KOS,LDG,LGL,NBB,NHA,NLG,NTL,NVL,PDR,PTL,QCG,SCR,SGR,SJS,TCH,TDC,TDH,THG,TNT,VHM,VIC,VPH,VPI,VRC,VRE,BCM,D2D,GVR,KBC,LHG,NTC,PHR,SIP,SZC,SZL,TIP,TIX,VGC,IJC,CEO,L18,HLD,HUT,IDC,IDV";
DS_ChungKhoan = "AGR,APG,BSI,CTS,DSC,DSE,EVF,FTS,HCM,ORS,SSI,TVB,TVS,VCI,VDS,VIX,VND,TCI,BVS,EVS,APS,SHS,MBS,TVC,PSI,BMS,SBS,WSS,AAS,TCX,VCK";
DS_BaoHiem = "BIC,BMI,BVH,MIG,PGI,ABI,VNR,PVI,PRE,PTI";
DS_XayDung = "ACC,BCE,C47,CDC,CIG,CTD,CTI,DC4,DPG,DLG,FCM,FCN,HHV,HID,HTI,L10,LCG,LGC,LM8,PHC,PTC,SC5,SRF,VCG,VSI,BMP,C32,CCC,CRC,CVT,DHA,DXV,HCD,HT1,KSB,LBM,MDG,NNC,TCR,TLD,HUB,NO1,NTP,HBC";
DS_ThepKhoangSan = "DTL,HMC,HPG,HSG,NKG,SMC,TLH,VCA,BMC,DHM,PLP,VPG,YBM,TVN,VGS,POM,GDA,KSV,HGM";
DS_DauKhiDienNuoc = "ASP,BSR,CNG,COM,GAS,PGC,PGD,PLX,PVD,SFC,BTP,BWE,CHP,CLW,DRL,GEG,GHC,HNA,KHP,NT2,PC1,PGV,POW,PPC,REE,S4A,SBA,SHP,SJD,TBC,TDM,TDW,TMP,TTA,TV2,VPD,VSH,TDG,PIT,PVC,OIL,PVS,PLC,PVB,TV1,QTP,HND,PVG";
DS_HoaChatCaoSu = "BFC,CSV,DCM,DGC,DPM,HII,SFG,VFG,BRC,CSM,DPR,DRC,HRC,SRC,TNC,TRC,AAA,APH,TDP,TPC,NAV,NHH,VPS,NET,LAS,DRI";
DS_ThucPhamNongSan = "BBC,BHN,CLC,KDC,LSS,MCH,MSN,NAF,SAB,SBT,VCF,VNM,AAN,ABS,ANT,BAF,DBC,HAG,HSL,NSC,PAN,SSC,TSC,AAM,ABT,ACL,ANV,CMX,FMC,IDI,VHC,LAF,LIX,MCM,SMB,QNS,SLS,LTG,TAR,HNG";
DS_BanLeOto = "ADP,CMV,DGW,FRT,MWG,PET,PNJ,ST8,CTF,HAX,HHS,HTL,SVC,TMT,TLG,PTB,PSD";
DS_DetMayGo = "AAT,ADS,EVE,GIL,HTG,KMR,MSH,STK,SVD,TCM,TVT,ACG,BKG,GDT,GTA,SAV,TTF,DHC,HHP,MCP,SVI,VID,TNG,VGT";
DS_LogisticsVanTai = "CLL,DVP,GMD,HAH,HTV,ILB,NCT,PDN,QNP,SCS,SFI,SGN,STG,TCL,TCO,TMS,VSC,VTP,GSP,HVN,PJT,PVP,PVT,SKG,VJC,VNL,VNS,VOS,VTO,MHC,VIP,DXP,PHP";
DS_CongNgheVienThong = "ADG,CMG,ELC,FPT,ICT,ITD,SVT,CTR,HAS,TSA,VTB,ABR,PNC,YEG,VGI,FOX,FOC";
DS_YTe = "DBD,DBT,DCL,DHG,DMC,IMP,JVC,OPC,SPM,TNH,TRA,VDP,VMD,LDP,DHT";
DS_ThietBiDienDuLich = "CAV,DQC,GEE,GEL,GEX,PAC,RAL,SHA,SHI,TYA,AST,DAH,DSN,NVT,OGC,TCT,VNG,VPL,RIC,ACV,SAS";

// SAN GIAO DICH - phuc vu bo loc "San" tren web. Mac dinh la HOSE (dung cho
// toan bo ~310 ma nen tang cu). Cac ma MOI bo sung o tren khi mo rong het
// cac san (HNX/UPCOM) duoc liet ke rieng o day de gan dung nhan san.
// LUU Y: cong thuc RS/breadth trong file nay van dang so voi VNINDEX (chi so
// rieng HOSE) - voi ma HNX/UPCOM day chi la muc tham khao gan dung, khong
// hoan toan chinh xac nhu voi ma HOSE.
DS_SanHNX = "CEO,L18,HLD,BVS,EVS,APS,SHS,MBS,TVC,PSI,BMS,WSS,AAS,NVB,VGS,PVC,PVS,PLC,PVB,VNR,PVI,PSD,TV1,PVG,LDP,DHT,TNG,DXP,NET,LAS,HGM,NTP,VNA";
DS_SanUPCOM = "KLB,BVB,VAB,NTC,STG,MCH,TVN,OIL,ABB,BAB,ABI,PRE,PTI,IDC,IDV,FOC,QTP,HND,SAS,ACV,VGI,VGT,PHP,QNS,SLS,LTG,DRI,KSV";
TrenSanHNX = StrFind( "," + DS_SanHNX + ",", "," + Name() + "," ) > 0;
TrenSanUPCOM = StrFind( "," + DS_SanUPCOM + ",", "," + Name() + "," ) > 0;
SanHienTai = WriteIf(TrenSanHNX, "HNX", WriteIf(TrenSanUPCOM, "UPCOM", "HOSE"));

// So luong ma trong tung DS_ - PHAI khop dung so phan tu thuc te trong chuoi
// (StrExtract loi/tra rong neu vuot qua), da cap nhat lai sau khi bo sung
// them ma o tren (mot vai con so cu truoc day da bi LECH so voi thuc te,
// vd DS_BDS thuc co 60 ma nhung chi duyet 58 - tien the sua luon).
Breadth_NganHang = TinhBreadth(DS_NganHang, 25);
Breadth_BDS = TinhBreadth(DS_BDS, 66);
Breadth_ChungKhoan = TinhBreadth(DS_ChungKhoan, 31);
Breadth_BaoHiem = TinhBreadth(DS_BaoHiem, 10);
Breadth_XayDung = TinhBreadth(DS_XayDung, 44);
Breadth_ThepKhoangSan = TinhBreadth(DS_ThepKhoangSan, 19);
Breadth_DauKhiDienNuoc = TinhBreadth(DS_DauKhiDienNuoc, 48);
Breadth_HoaChatCaoSu = TinhBreadth(DS_HoaChatCaoSu, 26);
Breadth_ThucPhamNongSan = TinhBreadth(DS_ThucPhamNongSan, 40);
Breadth_BanLeOto = TinhBreadth(DS_BanLeOto, 17);
Breadth_DetMayGo = TinhBreadth(DS_DetMayGo, 24);
Breadth_LogisticsVanTai = TinhBreadth(DS_LogisticsVanTai, 33);
Breadth_CongNgheVienThong = TinhBreadth(DS_CongNgheVienThong, 17);
Breadth_YTe = TinhBreadth(DS_YTe, 15);
Breadth_ThietBiDienDuLich = TinhBreadth(DS_ThietBiDienDuLich, 21);

Breadth_TB_Chung = (Breadth_NganHang+Breadth_BDS+Breadth_ChungKhoan+Breadth_BaoHiem+Breadth_XayDung
    +Breadth_ThepKhoangSan+Breadth_DauKhiDienNuoc+Breadth_HoaChatCaoSu+Breadth_ThucPhamNongSan
    +Breadth_BanLeOto+Breadth_DetMayGo+Breadth_LogisticsVanTai+Breadth_CongNgheVienThong
    +Breadth_YTe+Breadth_ThietBiDienDuLich) / 15;

MaTenBG = Name();
TrongNH = StrFind("," + DS_NganHang + ",", "," + MaTenBG + ",") > 0;
TrongBDS = StrFind("," + DS_BDS + ",", "," + MaTenBG + ",") > 0;
TrongCK = StrFind("," + DS_ChungKhoan + ",", "," + MaTenBG + ",") > 0;
TrongBH = StrFind("," + DS_BaoHiem + ",", "," + MaTenBG + ",") > 0;
TrongXD = StrFind("," + DS_XayDung + ",", "," + MaTenBG + ",") > 0;
TrongTK = StrFind("," + DS_ThepKhoangSan + ",", "," + MaTenBG + ",") > 0;
TrongDK = StrFind("," + DS_DauKhiDienNuoc + ",", "," + MaTenBG + ",") > 0;
TrongHC = StrFind("," + DS_HoaChatCaoSu + ",", "," + MaTenBG + ",") > 0;
TrongTP = StrFind("," + DS_ThucPhamNongSan + ",", "," + MaTenBG + ",") > 0;
TrongBL = StrFind("," + DS_BanLeOto + ",", "," + MaTenBG + ",") > 0;
TrongDM = StrFind("," + DS_DetMayGo + ",", "," + MaTenBG + ",") > 0;
TrongLG = StrFind("," + DS_LogisticsVanTai + ",", "," + MaTenBG + ",") > 0;
TrongCN = StrFind("," + DS_CongNgheVienThong + ",", "," + MaTenBG + ",") > 0;
TrongYT = StrFind("," + DS_YTe + ",", "," + MaTenBG + ",") > 0;
TrongTB = StrFind("," + DS_ThietBiDienDuLich + ",", "," + MaTenBG + ",") > 0;

BreadthPctNganh = IIf(TrongNH, Breadth_NganHang,
                   IIf(TrongBDS, Breadth_BDS,
                   IIf(TrongCK, Breadth_ChungKhoan,
                   IIf(TrongBH, Breadth_BaoHiem,
                   IIf(TrongXD, Breadth_XayDung,
                   IIf(TrongTK, Breadth_ThepKhoangSan,
                   IIf(TrongDK, Breadth_DauKhiDienNuoc,
                   IIf(TrongHC, Breadth_HoaChatCaoSu,
                   IIf(TrongTP, Breadth_ThucPhamNongSan,
                   IIf(TrongBL, Breadth_BanLeOto,
                   IIf(TrongDM, Breadth_DetMayGo,
                   IIf(TrongLG, Breadth_LogisticsVanTai,
                   IIf(TrongCN, Breadth_CongNgheVienThong,
                   IIf(TrongYT, Breadth_YTe,
                   IIf(TrongTB, Breadth_ThietBiDienDuLich,
                   Breadth_TB_Chung)))))))))))))));

// NHAN NGANH cho tung ma (dung chung uu tien voi BreadthPctNganh o tren) -
// phuc vu bo loc "Nganh" tren web. Mot ma co the nam trong nhieu DS_ (vd BDS
// KCN) nen chi lay NGANH DAU TIEN khop theo dung thu tu uu tien nay.
NganhHienTai = WriteIf(TrongNH, "Ngan hang",
               WriteIf(TrongBDS, "Bat dong san",
               WriteIf(TrongCK, "Chung khoan",
               WriteIf(TrongBH, "Bao hiem",
               WriteIf(TrongXD, "Xay dung",
               WriteIf(TrongTK, "Thep - Khoang san",
               WriteIf(TrongDK, "Dau khi - Dien - Nuoc",
               WriteIf(TrongHC, "Hoa chat - Cao su",
               WriteIf(TrongTP, "Thuc pham - Nong san",
               WriteIf(TrongBL, "Ban le - O to",
               WriteIf(TrongDM, "Det may - Go",
               WriteIf(TrongLG, "Logistics - Van tai",
               WriteIf(TrongCN, "Cong nghe - Vien thong",
               WriteIf(TrongYT, "Y te - Duoc",
               WriteIf(TrongTB, "Thiet bi dien - Du lich",
               "Khac")))))))))))))));

MocChuan = 100/8;
TyTrongTheoNganh = IIf(BatBreadthGate,
    IIf(BreadthPctNganh>=NguongManh, MocChuan*1.0,
    IIf(BreadthPctNganh>=NguongYeu, MocChuan*0.5,
    MocChuan*0.2)),
    MocChuan);
BreadthOk15 = 1;

// THANH KHOAN GATE - loai cac ma khoi luong giao dich qua thap (vd HTV chi
// vai tram co/phien) ra khoi tin hieu MUA/NAM GIU. Cac ma nay tuy diem so co
// the dat nguong nhung khong thuc te de vao/ra lenh (truot gia lon, kho
// khop lenh) nen khong nen duoc khuyen nghi dau tu.
NguongKLTB20ToiThieu = Param("Nguong KL trung binh 20 phien toi thieu (co phieu)", 80000, 0, 5000000, 10000);
ThanhKhoanKL_Ok = MA(V,20) >= NguongKLTB20ToiThieu;

// GIA TOI THIEU GATE - loai co phieu "tra" (duoi 10 = duoi 10,000 dong/cp,
// gia cua AmiBroker tinh theo nghin dong) ra khoi tin hieu MUA/NAM GIU. Cac
// ma gia qua thap thuong bi lam gia/thao tung, bien dong bat thuong, khong
// phu hop de khuyen nghi dau tu du diem so ky thuat co the dat nguong.
NguongGiaToiThieu = Param("Nguong gia toi thieu de duoc coi la giao dich duoc (nghin dong)", 10, 0, 100, 1);
GiaToiThieuOk = C >= NguongGiaToiThieu;

Buy = TurnedGreen AND ChiTrong12NamGanNhat AND BreadthOk15 AND RSVNI_OK AND ThanhKhoanKL_Ok AND GiaToiThieuOk;

// Mat Than KHONG con tu dong kich hoat Ban nua (da xac nhan qua Backtest
// that: Mat Than gio la CHI TIEU PHU/canh bao tham khao tren web, khong
// con quyet dinh Mua/Ban) - dong bo voi ban FULL_XemTatCa moi nhat.
SellRaw = TurnedPink;
DuT2 = BarsSince(Buy) >= 2;
SellTinHieu = SellRaw AND DuT2;

Sell = 0;
GiuTrongVongLap = 0;
GiaVaoTrongVongLap = 0;
ATRVaoTrongVongLap = 0;
for (i = 1; i < BarCount; i++)
{
    if (GiuTrongVongLap[i-1] == 1)
    {
        GiaVaoTrongVongLap[i] = GiaVaoTrongVongLap[i-1];
        ATRVaoTrongVongLap[i] = ATRVaoTrongVongLap[i-1];
        stopATR_vonglap = ATRVaoTrongVongLap[i] * ATRMult;
        stopPhanTram_vonglap = GiaVaoTrongVongLap[i] * (HardStopPct/100);
        stopGiaThucTe_vonglap = GiaVaoTrongVongLap[i] - Min(stopATR_vonglap, stopPhanTram_vonglap);

        // Cham Stop-loss ve gia CHI thuc su Ban khi diem cung da am (<0) -
        // tranh cat lo oan neu chi la ria/bong nen tam thoi trong khi diem
        // ky thuat van con on, theo yeu cau nguoi dung.
        if (SellTinHieu[i] == 1 OR (L[i] <= stopGiaThucTe_vonglap AND TotalScore[i] < 0))
        {
            Sell[i] = 1;
            GiuTrongVongLap[i] = 0;
        }
        else
        {
            Sell[i] = 0;
            GiuTrongVongLap[i] = 1;
        }
    }
    else if (Buy[i])
    {
        GiuTrongVongLap[i] = 1;
        GiaVaoTrongVongLap[i] = C[i];
        ATRVaoTrongVongLap[i] = ATRVal[i];
    }
    else
    {
        GiuTrongVongLap[i] = 0;
    }
}
Buy = GiuTrongVongLap AND NOT Ref(GiuTrongVongLap,-1);
Sell = ExRem(Sell, Buy);

SoViTheToiDa = Param("SO VI THE TOI DA (thay the Settings->Portfolio)", 8, 4, 30, 1);
SetOption("MaxOpenPositions", SoViTheToiDa);

SetPositionSize(TyTrongTheoNganh, spsPercentOfEquity);
SetOption("CommissionMode", 1);
SetOption("CommissionAmount", 0.25);

ATRTaiVaoLenh    = ValueWhen(Buy, ATRVal, 1);
GiaMuaThucTe_Nhap = Param("Buoc 1: Go gia MUA THUC TE vao day", 0, 0, 999999, 0.01);
LuuGiaChoMaNay = ParamTrigger("Buoc 2: Bam de LUU gia cho DUNG MA NAY", "Luu gia");
if (LuuGiaChoMaNay AND LastValue(GiaMuaThucTe_Nhap) > 0)
{
    StaticVarSet("DaoGam_GiaMua_" + Name(), LastValue(GiaMuaThucTe_Nhap));
}
XoaGiaDaLuu = ParamTrigger("Hoac: Xoa gia da luu cho MA NAY", "Xoa gia");
if (XoaGiaDaLuu)
{
    StaticVarSet("DaoGam_GiaMua_" + Name(), 0);
}
GiaMuaThucTe = Nz(StaticVarGet("DaoGam_GiaMua_" + Name()));
GiaVaoLenh_MacDinh = ValueWhen(Buy, C, 1);
CoNhapGiaThucTe = GiaMuaThucTe > 0;
GiaVaoLenh       = IIf(CoNhapGiaThucTe, GiaMuaThucTe, GiaVaoLenh_MacDinh);

DiemDungATR      = ATRTaiVaoLenh * ATRMult;
DiemDungPhanTram = GiaVaoLenh * (HardStopPct/100);
DiemDungThucTe   = Min(DiemDungATR, DiemDungPhanTram);

ApplyStop(stopTypeLoss, stopModePoint, DiemDungThucTe, True);

StopLossPrice = GiaVaoLenh - DiemDungThucTe;
KhoangCachKijun = (C - Kijun) / C * 100;
KhoangCachGG = (C - (GGTop+GGBot)/2) / C * 100;

Dinh52T = HHV(H, 252); Day52T = LLV(L, 252);
DinhGanNhat = HHV(H, 60); DayGanNhat = LLV(L, 60);

KC1=IIf(Dinh52T>C,Dinh52T,1e10);
KC2=IIf(GGTop>C,GGTop,1e10);
KC3=IIf(CloudTop>C,CloudTop,1e10);
KC4=IIf(DinhGanNhat>C,DinhGanNhat,1e10);
KhangCuGanNhat_V2 = Min(Min(KC1,KC2),Min(KC3,KC4));
KhangCuCungNhat = IIf(Dinh52T>C, Dinh52T, KhangCuGanNhat_V2);

// 3 MOC CHOT LOI - dung 3 nguon Khang cu on dinh: Dinh gan (60 phien, ngan
// han), Mua/Giao Gam (trung han), Dinh 52 tuan (dai han).
// FIX: ma vua BREAKOUT (gia hien tai da VUOT QUA 1 hoac ca 3 nguon khang cu
// nay) thi nguon do KHONG CON la khang cu thuc su - giu nguyen se khien TP
// tinh ra THAP HON gia mua, dan den "vua mua da bao chot loi" (vd TRC mua
// gia 21.35 nhung TP1 tinh ra 19.84). Dam bao moi nguon LUON o tren gia hien
// tai bang 1 san toi thieu (5%/10%/15%) - giu nguyen gia tri that neu no da
// o tren san do (truong hop binh thuong, khong breakout).
NguonGan   = Max(DinhGanNhat, C * 1.05);
NguonGiua  = Max(Max(GGTop, CloudTop), C * 1.10);
NguonXa    = Max(Dinh52T, C * 1.15);
Tong3Nguon = NguonGan + NguonGiua + NguonXa;
ChotLoi_TP1 = Min(Min(NguonGan,NguonGiua),NguonXa);
ChotLoi_TP3 = Max(Max(NguonGan,NguonGiua),NguonXa);
ChotLoi_TP2 = Tong3Nguon - ChotLoi_TP1 - ChotLoi_TP3;

// DONG BANG 3 moc TP tai DUNG thoi diem Mua (giong cach da lam voi GiaVaoLenh
// va StopLossPrice) - tranh TP "chay theo" khang cu moi moi ngay, giup cot
// Chot loi tren web phan anh dung muc tieu that su tai luc vao lenh. Dong bo
// voi ban FULL_XemTatCa moi nhat.
ChotLoi_TP1_TaiMua = ValueWhen(Buy, ChotLoi_TP1, 1);
ChotLoi_TP2_TaiMua = ValueWhen(Buy, ChotLoi_TP2, 1);
ChotLoi_TP3_TaiMua = ValueWhen(Buy, ChotLoi_TP3, 1);

HT1=IIf(Day52T<C,Day52T,-1e10);
HT2=IIf(GGBot<C,GGBot,-1e10);
HT3=IIf(CloudBot<C,CloudBot,-1e10);
HT4=IIf(DayGanNhat<C,DayGanNhat,-1e10);
HoTroGanNhat_V2 = Max(Max(HT1,HT2),Max(HT3,HT4));
HoTroCungNhat = IIf(Day52T<C, Day52T, HoTroGanNhat_V2);

PhanTramDoi = (C/Ref(C,-1) - 1) * 100; // % thay doi gia so voi phien truoc (rieng cho web)
// Dong bo dung don vi voi DaoGam_Scanner_v14.afl (chuan chinh thuc): trieu
// dong/phien, KHONG phai dong tho - truoc day web tinh sai (thieu /1e6).
GiaTriGDTB20 = MA(C * V, 20) / 1000000;

DangGiuLenhVT = Flip(Buy, Sell);
GiaVaoLenh_ChoStop = GiaVaoLenh;
ATRVaoLenh_ChoStop = ValueWhen(Buy, ATRVal, 1);
StopThucTe_ChoHienThi = Min(ATRVaoLenh_ChoStop*ATRMult, GiaVaoLenh_ChoStop*(HardStopPct/100));
GiaStopThucTe_ChoHienThi = GiaVaoLenh_ChoStop - StopThucTe_ChoHienThi;
CoTheDaChamStop = DangGiuLenhVT AND (C <= GiaStopThucTe_ChoHienThi);

GiaMuaVT = GiaVaoLenh;
SoPhienNamGiuVT = BarsSince(Buy);
LaiLoVT = IIf(GiaMuaVT>0, (C/GiaMuaVT-1)*100, 0);

// NGAY VAO LENH THAT (khong uoc tinh) - dong bang Nam/Thang/Ngay tai dung
// phien Buy, giong y het cach GiaVaoLenh da dong bang gia (ValueWhen).
NamMuaVT = ValueWhen(Buy, Year(), 1);
ThangMuaVT = ValueWhen(Buy, Month(), 1);
NgayMuaVT = ValueWhen(Buy, Day(), 1);

VuaMuaHomNay = Buy;
DangGiuTuTruoc = DangGiuLenhVT AND NOT VuaMuaHomNay AND NOT Sell;
BanHomNay = Sell;
DungNgoai = NOT DangGiuLenhVT AND NOT VuaMuaHomNay;

// CANH BAO BAN BOT - diem hom nay da roi duoi nguong Ban (-ExitTh, mac dinh
// -1.5) - MOT PHIEN DUY NHAT, chua can du 3 phien xac nhan lien tuc nhu Ban
// han (TurnedPink) - nhung VAN DANG GIU lenh va CHUA co tin hieu Ban that su
// hom nay. Goi y giam bot vi the SOM hon, khong doi den luc diem xau han/du
// 3 phien moi Ban toan bo.
CanhBaoBanBot = DangGiuLenhVT AND ZoneSell AND NOT BanHomNay;

// ============================================================================
// SCANNER - QUET TOAN BO THI TRUONG (Explore)
// ============================================================================
KhuyenNghi = WriteIf(VuaMuaHomNay, "MUA",
             WriteIf(DangGiuTuTruoc, "NAM GIU",
             WriteIf(BanHomNay, "BAN", "TRUNG LAP")));

ChiPhienCuoi = BarIndex() == LastValue(BarIndex());
// Loai ma chung chi quy ETF (bat dau bang "FUE", vd FUEVFVND, FUESSVFL...) -
// day khong phai co phieu cong ty, chien luoc Dao Gam khong dung cho ETF.
// TRUOC DAY chi quet co phieu HOSE. Da MO RONG sang ca HNX/UPCOM theo yeu
// cau (xem DS_SanHNX/DS_SanUPCOM o tren) - ten bien ThuocHOSE giu nguyen de
// khong phai sua lai moi cho dùng, nhung nay thuc chat nghia la "nam trong
// 1 trong 3 danh sach VN30/Midcap/Smallcap dang quet" (khong phan biet san).
LaMaETF = StrLeft(Name(), 3) == "FUE";
ThuocHOSE = InVN30 OR InVNMidCap OR InVNSmallCap;
// VNINDEX duoc xuat THEM nhu 1 truong hop dac biet (khong phai co phieu, khong
// nam trong 3 danh sach von hoa o tren) - de trang web co the hien PTKT (diem
// so/Ichimoku/Giao Gam/ho tro-khang cu) cho CHINH chi so, dung y het cong thuc
// da dung cho tung ma. Front-end se loc rieng dong nay ra khoi danh sach co
// phieu (nhan dien qua von_hoa="ChiSo").
LaVNIndex = Name() == "VNINDEX";
Filter = ChiPhienCuoi AND ((NOT LaMaETF AND ThuocHOSE) OR LaVNIndex);

AddTextColumn(Name(), "Ma");
AddTextColumn(KhuyenNghi, "Khuyen nghi");
AddColumn(TotalScore, "Diem", 1.2);
AddColumn(C, "Gia", 1.2);
AddColumn(PhanTramDoi, "Doi hom nay(%)", 1.2);
AddColumn(StopLossPrice, "Stop-loss", 1.2);
AddTextColumn(WriteIf(MatThanWarning,"CANH BAO","-"), "Mat Than");
AddTextColumn(WriteIf(CanhBaoBanBot,"BAN BOT","-"), "Ban bot");
AddColumn(ChotLoi_TP1_TaiMua, "TP1 (dong bang luc mua)", 1.2);
AddColumn(ChotLoi_TP2_TaiMua, "TP2 (dong bang luc mua)", 1.2);
AddColumn(ChotLoi_TP3_TaiMua, "TP3 (dong bang luc mua)", 1.2);
AddColumn(SoDiemSanyaku, "Sanyaku(0-3)", 1.0);
AddTextColumn(WriteIf(InVN30,"VN30",WriteIf(InVNMidCap,"Midcap",WriteIf(InVNSmallCap,"Smallcap","Khac"))), "Von hoa");
AddTextColumn(SanHienTai, "San");
AddTextColumn(NganhHienTai, "Nganh");

// ============================================================================
// XUAT CSV TU DONG LEN WEB - KHONG CAN BAM "EXPORT" TAY
// SUA DUONG DAN NAY cho khop may ban truoc khi dung (tao san thu muc neu chua co).
// ============================================================================
DuongDanFileXuat = "C:\\DaoGam_Data\\tin_hieu_hom_nay.csv";

if (Status("stocknum") == 0)
{
    fh = fopen(DuongDanFileXuat, "w");
    if (fh)
    {
        fputs("ma,tin,diem,trend,mom,dt,adx,gia,doi,rs_vni,breadth_nganh,kijun,gg_top,gg_bot,dinh_52t,"+
              "stop_loss,mat_than,tp1,tp2,tp3,gtgd_tb20,fvg_ok,so_phien_giu,lai_lo_pct,sanyaku,"+
              "kumo_twist,ngay_bien_doi,von_hoa,gia_mua,ngay_mua,ban_bot,san,nganh\n", fh);
        fclose(fh);
    }
}

// Khong the danh chi so [b] tren bieu thuc chu/logic ghep (loi "Subscript
// operator [] requires array or number type"). Dung LastValue() tren tung
// mang so lieu goc de lay gia tri phien cuoi cung, roi ghep chuoi bang IIf
// (scalar) - cach nay AmiBroker luon chap nhan.
KhuyenNghiCuoi = LastValue(VuaMuaHomNay);
DangGiuCuoi    = LastValue(DangGiuTuTruoc);
BanCuoi        = LastValue(BanHomNay);
TinCuoi = WriteIf(KhuyenNghiCuoi, "MUA",
          WriteIf(DangGiuCuoi, "NAM GIU",
          WriteIf(BanCuoi, "BAN", "TRUNG LAP")));

MatThanCuoi = WriteIf(LastValue(MatThanWarning), "1", "0");
FVGCuoi = WriteIf(LastValue(FVGDuLon), "1", "0");
NgayBienDoiCuoi = WriteIf(LastValue(DungNgayBienDoi), "1", "0");
KumoTwistCuoi = WriteIf(LastValue(MayTuongLaiDoiChieuTang), "TANG",
                WriteIf(LastValue(MayTuongLaiDoiChieuGiam), "GIAM", ""));
VonHoaCuoi = WriteIf(LaVNIndex, "ChiSo",
             WriteIf(LastValue(InVN30), "VN30",
             WriteIf(LastValue(InVNMidCap), "Midcap",
             WriteIf(LastValue(InVNSmallCap), "Smallcap", "Khac"))));

Dong = Name() + "," + TinCuoi + ","
     + NumToStr(LastValue(TotalScore),1.4,False) + ","
     + NumToStr(LastValue(TrendScore),1.4,False) + ","
     + NumToStr(LastValue(MomScore),1.4,False) + ","
     + NumToStr(LastValue(MFScore),1.4,False) + ","
     + NumToStr(LastValue(ADXVal),1.2,False) + ","
     + NumToStr(LastValue(C),1.2,False) + ","
     + NumToStr(LastValue(PhanTramDoi),1.4,False) + ","
     + NumToStr(LastValue(RS_SoVoiVNI),1.4,False) + ","
     + NumToStr(LastValue(BreadthPctNganh),1.2,False) + ","
     + NumToStr(LastValue(Kijun),1.2,False) + ","
     + NumToStr(LastValue(GGTop),1.2,False) + ","
     + NumToStr(LastValue(GGBot),1.2,False) + ","
     + NumToStr(LastValue(Dinh52T),1.2,False) + ","
     + NumToStr(LastValue(StopLossPrice),1.2,False) + ","
     + MatThanCuoi + ","
     + NumToStr(LastValue(ChotLoi_TP1_TaiMua),1.2,False) + ","
     + NumToStr(LastValue(ChotLoi_TP2_TaiMua),1.2,False) + ","
     + NumToStr(LastValue(ChotLoi_TP3_TaiMua),1.2,False) + ","
     + NumToStr(LastValue(GiaTriGDTB20),1.0,False) + ","
     + FVGCuoi + ","
     + NumToStr(LastValue(SoPhienNamGiuVT),1.0,False) + ","
     + NumToStr(LastValue(LaiLoVT),1.4,False) + ","
     + NumToStr(LastValue(SoDiemSanyaku),1.0,False) + ","
     + KumoTwistCuoi + ","
     + NgayBienDoiCuoi + ","
     + VonHoaCuoi + ","
     + NumToStr(LastValue(GiaMuaVT),1.2,False) + ","
     + WriteIf(LastValue(NamMuaVT) > 0,
         NumToStr(LastValue(NgayMuaVT),1.0,False) + "/" +
         NumToStr(LastValue(ThangMuaVT),1.0,False) + "/" +
         NumToStr(LastValue(NamMuaVT),1.0,False),
         "")
     + ","
     + WriteIf(LastValue(CanhBaoBanBot), "1", "0") + ","
     + WriteIf(LaVNIndex, "HOSE", SanHienTai) + ","
     + WriteIf(LaVNIndex, "ChiSo", NganhHienTai);

if ((!LaMaETF AND ThuocHOSE) OR LaVNIndex)
{
    fh = fopen(DuongDanFileXuat, "a");
    if (fh)
    {
        fputs(Dong + "\n", fh);
        fclose(fh);
    }
}

_SECTION_END();
